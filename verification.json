{
  "push": [
    {
      "name": "static",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run check -- --profile first-party",
        "pnpm run source:check",
        "pnpm run verify:base-source",
        "pnpm run feedback:status",
        "pnpm run build",
        "pnpm run deployment-spec:check",
        "pnpm run typecheck",
        "pnpm run lint",
        "pnpm run test:mail-runtime",
        "pnpm run test:data:commands",
        "node --test tests/installer/deploy-dry-run.test.mjs"
      ]
    },
    {
      "name": "base-1",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm exec vitest run --config vitest.base.config.ts --shard=1/2"
      ]
    },
    {
      "name": "base-2",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm exec vitest run --config vitest.base.config.ts --shard=2/2"
      ]
    },
    {
      "name": "browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node --test --test-concurrency=1 tests/browser/signin.test.mjs",
        "pnpm run test:browser:dev-credentials",
        "pnpm run test:browser:learning"
      ]
    },
    {
      "name": "dev-flows",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:browser:dev-flows"
      ]
    },
    {
