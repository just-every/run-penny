{
  "push": [
    {
      "name": "static",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run check -- --profile first-party",
        "pnpm run source:check",
        "pnpm run verify:base-source",
        "pnpm run feedback:status",
        "pnpm run build",
        "pnpm run check:deployment-spec",
        "pnpm run typecheck",
        "pnpm run eval:ai -- --set redaction-v1",
        "pnpm run lint",
        "pnpm run test:mail-runtime",
        "pnpm run test:data:commands",
        "node --test tests/installer/deploy-dry-run.test.mjs"
      ]
    },
    {
      "name": "base-1",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm exec vitest run --config vitest.base.config.ts --shard=1/2"
      ]
    },
    {
      "name": "base-2",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm exec vitest run --config vitest.base.config.ts --shard=2/2"
