{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    ".tanstack/**",
    "base/**"
  ],
  "overrides": [
    {
      "files": [
        "scripts/base-cli/cli/**/*.mjs"
      ],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
