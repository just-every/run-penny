{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/base/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.import-kit.json"
    }
  ]
}
