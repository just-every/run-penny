vision=revision+1 WHERE singleton=1; END","table":"tags","type":"trigger"},{"name":"feedback_native_tags_update","sql":"CREATE TRIGGER feedback_native_tags_update AFTER UPDATE ON \"tags\" BEGIN UPDATE feedback_import_native_revision SET revision=revision+1 WHERE singleton=1; END","table":"tags","type":"trigger"},{"name":"feedback_original_immutable_delete","sql":"CREATE TRIGGER feedback_original_immutable_delete BEFORE DELETE ON feedback_import_original_chunks WHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' BEGIN SELECT RAISE(ABORT,'feedback_original_changed'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_original_immutable_update","sql":"CREATE TRIGGER feedback_original_immutable_update BEFORE UPDATE ON feedback_import_original_chunks WHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' BEGIN SELECT RAISE(ABORT,'feedback_original_changed'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_original_sealed_insert","sql":"CREATE TRIGGER feedback_original_sealed_insert BEFORE INSERT ON feedback_import_original_chunks WHEN (SELECT sealed FROM feedback_import_bundles WHERE id=NEW.bundle_id)=1 AND (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NOT EXISTS(SELECT 1 FROM feedback_import_original_chunks WHERE bundle_id=NEW.bundle_id AND artifact=NEW.artifact AND ordinal=NEW.ordinal AND bytes=NEW.bytes) BEGIN SELECT RAISE(ABORT,'feedback_original_changed'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_preview_feedback_import_bundles_delete","sql":"CREATE TRIGGER feedback_preview_feedback_import_bundles_delete AFTER DELETE ON feedback_import_bundles BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_bundles","type":"trigger"},{"name":"feedback_preview_feedback_import_bundles_insert","sql":"CREATE TRIGGER feedback_preview_feedback_import_bundles_insert AFTER INSERT ON feedback_import_bundles BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_bundles","type":"trigger"},{"name":"feedback_preview_feedback_import_bundles_update","sql":"CREATE TRIGGER feedback_preview_feedback_import_bundles_update AFTER UPDATE ON feedback_import_bundles BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_bundles","type":"trigger"},{"name":"feedback_preview_feedback_import_original_chunks_delete","sql":"CREATE TRIGGER feedback_preview_feedback_import_original_chunks_delete AFTER DELETE ON feedback_import_original_chunks BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_preview_feedback_import_original_chunks_insert","sql":"CREATE TRIGGER feedback_preview_feedback_import_original_chunks_insert AFTER INSERT ON feedback_import_original_chunks BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_preview_feedback_import_original_chunks_update","sql":"CREATE TRIGGER feedback_preview_feedback_import_original_chunks_update AFTER UPDATE ON feedback_import_original_chunks BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"feedback_preview_feedback_import_receipt_notes_delete","sql":"CREATE TRIGGER feedback_preview_feedback_import_receipt_notes_delete AFTER DELETE ON feedback_import_receipt_notes BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"feedback_preview_feedback_import_receipt_notes_insert","sql":"CREATE TRIGGER feedback_preview_feedback_import_receipt_notes_insert AFTER INSERT ON feedback_import_receipt_notes BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"feedback_preview_feedback_import_receipt_notes_update","sql":"CREATE TRIGGER feedback_preview_feedback_import_receipt_notes_update AFTER UPDATE ON feedback_import_receipt_notes BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"feedback_preview_feedback_import_records_delete","sql":"CREATE TRIGGER feedback_preview_feedback_import_records_delete AFTER DELETE ON feedback_import_records BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_records","type":"trigger"},{"name":"feedback_preview_feedback_import_records_insert","sql":"CREATE TRIGGER feedback_preview_feedback_import_records_insert AFTER INSERT ON feedback_import_records BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_records","type":"trigger"},{"name":"feedback_preview_feedback_import_records_update","sql":"CREATE TRIGGER feedback_preview_feedback_import_records_update AFTER UPDATE ON feedback_import_records BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_records","type":"trigger"},{"name":"feedback_preview_feedback_import_tombstones_delete","sql":"CREATE TRIGGER feedback_preview_feedback_import_tombstones_delete AFTER DELETE ON feedback_import_tombstones BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_tombstones","type":"trigger"},{"name":"feedback_preview_feedback_import_tombstones_insert","sql":"CREATE TRIGGER feedback_preview_feedback_import_tombstones_insert AFTER INSERT ON feedback_import_tombstones BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_tombstones","type":"trigger"},{"name":"feedback_preview_feedback_import_tombstones_update","sql":"CREATE TRIGGER feedback_preview_feedback_import_tombstones_update AFTER UPDATE ON feedback_import_tombstones BEGIN UPDATE feedback_import_preview_revision SET revision=revision+1 WHERE singleton=1; END","table":"feedback_import_tombstones","type":"trigger"},{"name":"feedback_private_comment","sql":"CREATE TRIGGER feedback_private_comment BEFORE UPDATE OF moderation_state,published_at ON request_comments\nWHEN NEW.historical_private=1 AND (NEW.moderation_state='approved' OR NEW.published_at IS NOT NULL)\nBEGIN SELECT RAISE(ABORT,'historical_comment_private'); END","table":"request_comments","type":"trigger"},{"name":"ik_active_target","sql":"CREATE UNIQUE INDEX ik_active_target ON ik_provenance(destination,target_kind,target_id) WHERE reversed=0","table":"ik_provenance","type":"index"},{"name":"ik_d1_creation_plan_capture","sql":"CREATE TRIGGER ik_d1_creation_plan_capture AFTER INSERT ON ik_d1_plan_chunks BEGIN INSERT INTO ik_d1_creation_plans(job_id,ordinal,body) VALUES(NEW.job_id,NEW.ordinal,NEW.body); END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_creation_plan_immutable","sql":"CREATE TRIGGER ik_d1_creation_plan_immutable BEFORE UPDATE ON ik_d1_creation_plans WHEN NEW.job_id IS NOT OLD.job_id OR NEW.ordinal IS NOT OLD.ordinal OR NEW.body IS NOT OLD.body OR OLD.released<>0 OR NEW.released<>1 OR NOT EXISTS(SELECT 1 FROM ik_d1_plan_chunks p WHERE p.job_id=OLD.job_id AND p.ordinal=OLD.ordinal AND p.body IS OLD.body) BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_creation_plan_release","sql":"CREATE TRIGGER ik_d1_creation_plan_release BEFORE DELETE ON ik_d1_creation_plans WHEN OLD.released<>1 BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_chunks_delete","sql":"CREATE TRIGGER ik_d1_custody_chunks_delete AFTER DELETE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_insert","sql":"CREATE TRIGGER ik_d1_custody_chunks_insert AFTER INSERT ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_update","sql":"CREATE TRIGGER ik_d1_custody_chunks_update AFTER UPDATE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_job_insert","sql":"CREATE TRIGGER ik_d1_custody_job_insert AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_revisions(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_job_update","sql":"CREATE TRIGGER ik_d1_custody_job_update AFTER UPDATE OF plan_json ON ik_jobs BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.id OR job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_receipt_insert","sql":"CREATE TRIGGER ik_d1_custody_receipt_insert BEFORE INSERT ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_revision","sql":"CREATE TRIGGER ik_d1_custody_receipt_revision AFTER UPDATE OF revision ON ik_d1_custody_revisions BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_seal","sql":"CREATE TRIGGER ik_d1_custody_receipt_seal BEFORE UPDATE OF seal ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_state_create","sql":"CREATE TRIGGER ik_d1_custody_state_create AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_states(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_delete","sql":"CREATE TRIGGER ik_d1_custody_state_delete BEFORE DELETE ON ik_d1_custody_states WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_CUSTODY_STATE_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_delete AFTER DELETE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_insert AFTER INSERT ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_update AFTER UPDATE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_delete AFTER DELETE ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_insert AFTER INSERT ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_update AFTER UPDATE ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_delete AFTER DELETE ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_insert AFTER INSERT ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_update AFTER UPDATE ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_delete AFTER DELETE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_insert AFTER INSERT ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_update AFTER UPDATE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.source_identity=OLD.identity AND j.destination=OLD.destination) OR (i.source_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_delete AFTER DELETE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_insert AFTER INSERT ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_update AFTER UPDATE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.target_identity=OLD.identity AND j.destination=OLD.destination) OR (i.target_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_delete AFTER DELETE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_insert AFTER INSERT ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_update AFTER UPDATE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_delete AFTER DELETE ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_indexed_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_insert AFTER INSERT ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_indexed_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_update AFTER UPDATE ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_indexed_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_d