ER\n)"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"request_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"decision_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"connection_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider","notnull":1,"pk":0,"type":"TEXT"},{"name":"project_identity","notnull":1,"pk":0,"type":"TEXT"},{"name":"external_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"issue_url","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"source_updated_at","notnull":1,"pk":0,"type":"INTEGER"},{"name":"state_fingerprint","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["decisions","requests"],"name":"penny_tracker_links","rowidAlias":null,"sql":"CREATE TABLE penny_tracker_links (\n id TEXT PRIMARY KEY, request_id TEXT REFERENCES requests(id), decision_id TEXT REFERENCES decisions(id),\n connection_id TEXT NOT NULL, provider TEXT NOT NULL CHECK(provider IN('linear','jira')), project_identity TEXT NOT NULL,\n external_id TEXT NOT NULL, issue_url TEXT NOT NULL, state TEXT NOT NULL, source_updated_at INTEGER NOT NULL DEFAULT 0,\n state_fingerprint TEXT NOT NULL DEFAULT '', created_at INTEGER NOT NULL,\n CHECK((request_id IS NOT NULL AND decision_id IS NULL) OR (request_id IS NULL AND decision_id IS NOT NULL)),\n UNIQUE(connection_id,external_id)\n)"},{"columns":[{"name":"connection_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"delivery_id","notnull":1,"pk":2,"type":"TEXT"},{"name":"fingerprint","notnull":1,"pk":0,"type":"TEXT"},{"name":"link_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"source_updated_at","notnull":1,"pk":0,"type":"INTEGER"},{"name":"disposition","notnull":1,"pk":0,"type":"TEXT"},{"name":"received_at","notnull":1,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["penny_tracker_links"],"name":"penny_tracker_receipts","rowidAlias":null,"sql":"CREATE TABLE penny_tracker_receipts (\n connection_id TEXT NOT NUL