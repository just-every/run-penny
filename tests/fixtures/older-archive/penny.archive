esters(id),\n  operator_id TEXT REFERENCES operators(id),\n  body TEXT NOT NULL,\n  moderation_state TEXT NOT NULL CHECK (moderation_state IN ('awaiting_review', 'approved', 'rejected')),\n  published_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, rejection_reason TEXT, edited_at TEXT, public_author_display_name TEXT, public_author_kind TEXT CHECK (public_author_kind IN ('requester', 'operator')), origin_request_id TEXT, historical_private INTEGER NOT NULL DEFAULT 0 CHECK(historical_private IN (0,1)), historical_parent_id TEXT,\n  CHECK ((requester_id IS NOT NULL AND operator_id IS NULL) OR (requester_id IS NULL AND operator_id IS NOT NULL))\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"request_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"requester_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"title","notnull":1,"pk":0,"type":"TEXT"},{"name":"description","notnull":1,"pk":0,"type":"TEXT"},{"name":"proposed_solution","notnull":0,"pk":0,"type":"TEXT"},{"name":"impact_statement","notnull":0,"pk":0,"type":"TEXT"},{"name":"moderation_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"rejection_reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"approved_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"is_initial","notnull":1,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["requesters","requests"],"name":"request_content_submissions","rowidAlias":null,"sql":"CREATE TABLE request_content_submissions (\n  id TEXT PRIMARY KEY NOT NULL,\n  request_id TEXT NOT NULL REFERENCES requests(id),\n  requester_id TEXT NOT NULL REFERENCES requesters(id),\n  title TEXT NOT NULL,\n  description TEXT NOT NULL,\n  proposed_solution TEXT,\n  impact_statement TEXT,\n  moderation_state TEXT NOT NULL CHECK (moderation_state IN ('awaiting_review', 'approved', 'rejected')),\n  rejection_reason TEXT,\n  approved_at TEXT,\n  created_at TEXT