1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_attempts","type":"trigger"},{"name":"penny_integration_deliveries_delete","sql":"CREATE TRIGGER penny_integration_deliveries_delete BEFORE DELETE ON integration_deliveries\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_deliveries","type":"trigger"},{"name":"penny_integration_deliveries_insert","sql":"CREATE TRIGGER penny_integration_deliveries_insert BEFORE INSERT ON integration_deliveries\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_deliveries","type":"trigger"},{"name":"penny_integration_deliveries_update","sql":"CREATE TRIGGER penny_integration_deliveries_update BEFORE UPDATE ON integration_deliveries\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_deliveries","type":"trigger"},{"name":"penny_integration_replays_delete","sql":"CREATE TRIGGER penny_integration_replays_delete BEFORE DELETE ON integration_replays\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_replays","type":"trigger"},{"name":"penny_integration_replays_insert","sql":"CREATE TRIGGER penny_integration_replays_insert BEFORE INSERT ON integration_replays\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_replays","type":"trigger"},{"name":"penny_integration_replays_update","sql":"CREATE TRIGGER penny_integration_replays_update BEFORE UPDATE ON integration_replays\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_replays","type":"trigger"},{"name":"penny_integration_resolutions_delete","sql":"CREATE TRIGGER penny_integration_resolutions_delete BEFORE DELETE ON integration_resolutions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_resolutions","type":"trigger"},{"name":"penny_integration_resolutions_insert","sql":"CREATE TRIGGER penny_integration_resolutions_insert BEFORE INSERT ON integration_resolutions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_resolutions","type":"trigger"},{"name":"penny_integration_resolutions_update","sql":"CREATE TRIGGER penny_integration_resolutions_update BEFORE UPDATE ON integration_resolutions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"integration_resolutions","type":"trigger"},{"name":"penny_release_mail_audit_insert","sql":"CREATE TRIGGER penny_release_mail_audit_insert AFTER INSERT ON notification_outbox_attempts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND EXISTS(SELECT 1 FROM notification_outbox WHERE id=NEW.outbox_id AND event_type='release_version')\nBEGIN\n INSERT INTO audit_entries(id,actor_type,actor_id,action,entity_type,entity_id,occurred_at,created_at,updated_at)\n VALUES(lower(hex(randomblob(16))),'system','release_notifications','release_mail.attempt.'||NEW.state,'notification_outbox',NEW.outbox_id,NEW.created_at,NEW.created_at,NEW.created_at);\nEND","table":"notification_outbox_attempts","type":"trigger"},{"name":"penny_release_mail_audit_update","sql":"CREATE TRIGGER penny_release_mail_audit_update AFTER UPDATE OF state ON notification_outbox_attempts\nWHEN NEW.state<>OLD.state AND (SELECT phase FROM data_state WHERE singleton=1)='idle' AND EXISTS(SELECT 1 FROM notification_outbox WHERE id=NEW.outbox_id AND event_type='release_version')\nBEGIN\n INSERT INTO audit_entries(id,actor_type,actor_id,action,entity_type,entity_id,occurred_at,created_at,updated_at)\n VALUES(lower(hex(randomblob(16))),'system','release_notifications','release_mail.attempt.'||NEW.state,'notification_outbox',NEW.outbox_id,NEW.updated_at,NEW.updated_at,NEW.updated_at);\nEND","table":"notification_outbox_attempts","type":"trigger"},{"name":"penny_request_mail_audit_insert","sql":"CREATE TRIGGER penny_request_mail_audit_insert AFTER INSERT ON notification_attempts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO audit_entries(id,actor_type,actor_id,action,entity_type,entity_id,occurred_at,created_at,updated_at)\n VALUES(lower(hex(randomblob(16))),'system','request_notifications','request_mail.attempt.'||NEW.state,'notification_batch',NEW.batch_id,NEW.created_at,NEW.created_at,NEW.created_at);\nEND","table":"notification_attempts","type":"trigger"},{"name":"penny_request_mail_audit_update","sql":"CREATE TRIGGER penny_request_mail_audit_update AFTER UPDATE OF state ON notification_attempts\nWHEN NEW.state<>OLD.state AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO audit_entries(id,actor_type,actor_id,action,entity_type,entity_id,occurred_at,created_at,updated_at)\n VALUES(lower(hex(randomblob(16))),'system','request_notifications','request_mail.attempt.'||NEW.state,'notification_batch',NEW.batch_id,NEW.updated_at,NEW.updated_at,NEW.updated_at);\nEND","table":"notification_attempts","type":"trigger"},{"name":"penny_request_status","sql":"CREATE VIEW penny_request_status AS\n WITH mapped AS (\n SELECT r.id AS request_id,r.public_state,r.latest_status_source,r.direct_status_changed_at,r.mapped_status_changed_at,\n  i.status AS roadmap_status,s.name AS internal_name,s.show_public_label,s.public_status AS internal_public_status\n FROM requests r LEFT JOIN request_internal_statuses s ON s.id=r.internal_status_id\n LEFT JOIN roadmap_request_mappings m ON m.request_id=r.id AND m.approved_at IS NOT NULL AND m.withdrawn_at IS NULL\n LEFT JOIN roadmap_publications p ON p.roadmap_item_id=m.roadmap_item_id AND p.approved_at IS NOT NULL AND p.withdrawn_at IS NULL\n  AND (p.board_id IS NULL OR EXISTS(SELECT 1 FROM boards b WHERE b.id=p.board_id AND b.visibility='public' AND b.archived_at IS NULL))\n LEFT JOIN roadmap_items i ON i.id=p.roadmap_item_id AND i.status!='dropped'\n ), resolved AS (\n SELECT *,CASE WHEN public_state NOT IN ('declined','withdrawn','unpublished') AND latest_status_source='roadmap' AND roadmap_status IS NOT NULL THEN 'roadmap' ELSE 'direct' END AS source FROM mapped\n )\n SELECT request_id,source,\n CASE WHEN source='roadmap' THEN CASE WHEN roadmap_status='exploring' THEN 'under_review' ELSE roadmap_status END ELSE public_state END AS status,\n CASE WHEN source='roadmap' THEN mapped_status_changed_at ELSE direct_status_changed_at END AS changed_at,\n CASE WHEN source='direct' AND show_public_label=1 AND internal_public_status=public_state THEN internal_name END AS public_label\n FROM resolved","table":"penny_request_status","type":"view"},{"name":"release_delivery_command_immutable","sql":"CREATE TRIGGER release_delivery_command_immutable BEFORE UPDATE OF delivery_requested_at ON release_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.delivery_requested_at IS NOT NULL\n AND NEW.delivery_requested_at IS NOT OLD.delivery_requested_at\nBEGIN SELECT RAISE(ABORT,'delivery command is immutable'); END","table":"release_versions","type":"trigger"},{"name":"release_identity_merge_guard","sql":"CREATE TRIGGER release_identity_merge_guard BEFORE INSERT ON requester_identity_merges\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\n AND EXISTS(SELECT 1 FROM notification_outbox n JOIN notification_outbox_attempts a ON a.id=n.claim_id\n WHERE a.state='sending' AND n.requester_id IN(NEW.source_requester_id,NEW.target_requester_id))\nBEGIN SELECT RAISE(ABORT,'identity_merge_notification_active'); END","table":"requester_identity_merges","type":"trigger"},{"name":"release_original_publication_immutable","sql":"CREATE TRIGGER release_original_publication_immutable BEFORE UPDATE OF original_publication_version_id ON release_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.snapshot_sealed_at IS NOT NULL\n AND NEW.original_publication_version_id IS NOT OLD.original_publication_version_id\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_versions","type":"trigger"},{"name":"release_outcomes_current","sql":"CREATE INDEX release_outcomes_current ON release_outcomes(release_version_id,requester_id,roadmap_item_id,revision_number DESC)","table":"release_outcomes","type":"index"},{"name":"release_recipient_contexts_immutable_delete","sql":"CREATE TRIGGER release_recipient_contexts_immutable_delete BEFORE DELETE ON release_recipient_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_recipient_snapshots s JOIN release_versions v ON v.id=s.release_version_id WHERE s.id=OLD.snapshot_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_contexts","type":"trigger"},{"name":"release_recipient_contexts_immutable_insert","sql":"CREATE TRIGGER release_recipient_contexts_immutable_insert BEFORE INSERT ON release_recipient_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_recipient_snapshots s JOIN release_versions v ON v.id=s.release_version_id WHERE s.id=NEW.snapshot_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_contexts","type":"trigger"},{"name":"release_recipient_contexts_immutable_update","sql":"CREATE TRIGGER release_recipient_contexts_immutable_update BEFORE UPDATE ON release_recipient_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_recipient_snapshots s JOIN release_versions v ON v.id=s.release_version_id WHERE s.id=OLD.snapshot_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM release_recipient_snapshots s JOIN release_versions v ON v.id=s.release_version_id WHERE s.id=NEW.snapshot_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_contexts","type":"trigger"},{"name":"release_recipient_snapshots_immutable_delete","sql":"CREATE TRIGGER release_recipient_snapshots_immutable_delete BEFORE DELETE ON release_recipient_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=OLD.release_version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_snapshots","type":"trigger"},{"name":"release_recipient_snapshots_immutable_insert","sql":"CREATE TRIGGER release_recipient_snapshots_immutable_insert BEFORE INSERT ON release_recipient_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=NEW.release_version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_snapshots","type":"trigger"},{"name":"release_recipient_snapshots_immutable_update","sql":"CREATE TRIGGER release_recipient_snapshots_immutable_update BEFORE UPDATE ON release_recipient_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=OLD.release_version_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM release_versions v WHERE v.id=NEW.release_version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_recipient_snapshots","type":"trigger"},{"name":"release_target_snapshots_immutable_delete","sql":"CREATE TRIGGER release_target_snapshots_immutable_delete BEFORE DELETE ON release_target_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_target_snapshots","type":"trigger"},{"name":"release_target_snapshots_immutable_insert","sql":"CREATE TRIGGER release_target_snapshots_immutable_insert BEFORE INSERT ON release_target_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_target_snapshots","type":"trigger"},{"name":"release_target_snapshots_immutable_update","sql":"CREATE TRIGGER release_target_snapshots_immutable_update BEFORE UPDATE ON release_target_snapshots\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM release_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM release_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_target_snapshots","type":"trigger"},{"name":"release_versions_seal_immutable","sql":"CREATE TRIGGER release_versions_seal_immutable BEFORE UPDATE OF snapshot_sealed_at,publication_claim ON release_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.snapshot_sealed_at IS NOT NULL\n AND (NEW.snapshot_sealed_at IS NOT OLD.snapshot_sealed_at OR NEW.publication_claim IS NOT OLD.publication_claim)\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"release_versions","type":"trigger"},{"name":"release_wording_immutable","sql":"CREATE TRIGGER release_wording_immutable BEFORE UPDATE OF title,release_type,body,publication_date,setup_url,outcome_prompt,subject_tags_json,author_name,tag_names_json ON release_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.snapshot_sealed_at IS NOT NULL\nBEGIN SELECT RAISE(ABORT,'published wording is immutable'); END","table":"release_versions","type":"trigger"},{"name":"request_attachment_origin","sql":"CREATE TRIGGER request_attachment_origin AFTER INSERT ON attachments WHEN NEW.origin_request_id IS NULL\nBEGIN UPDATE attachments SET origin_request_id=NEW.request_id WHERE id=NEW.id; END","table":"attachments","type":"trigger"},{"name":"request_canonical_roots","sql":"CREATE VIEW request_canonical_roots AS\nWITH RECURSIVE paths(origin_id, current_id, depth) AS (\n  SELECT id, id, 0 FROM requests\n  UNION ALL\n  SELECT paths.origin_id, r.merged_into_request_id, paths.depth+1 FROM paths\n  JOIN requests r ON r.id = paths.current_id WHERE r.merged_into_request_id IS NOT NULL\n)\nSELECT paths.origin_id, paths.current_id AS canonical_id,paths.depth FROM paths\nJOIN requests r ON r.id = paths.current_id WHERE r.merged_into_request_id IS NULL","table":"request_canonical_roots","type":"view"},{"name":"request_categories_board_order_idx","sql":"CREATE INDEX request_categories_board_order_idx ON request_categories(board_id,parent_id,position,name)","table":"request_categories","type":"index"},{"name":"request_category_board_insert","sql":"CREATE TRIGGER request_category_board_insert BEFORE INSERT ON requests\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.category_id IS NOT NULL BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM request_categories c WHERE c.id=NEW.category_id AND c.board_id=NEW.board_id AND c.merged_into_category_id IS NULL)\n THEN RAISE(ABORT,'invalid_request_category') END;\nEND","table":"requests","type":"trigger"},{"name":"request_category_board_update","sql":"CREATE TRIGGER request_category_board_update BEFORE UPDATE OF board_id,category_id ON requests\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.category_id IS NOT NULL BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM request_categories c WHERE c.id=NEW.category_id AND c.board_id=NEW.board_id AND c.merged_into_category_id IS NULL)\n THEN RAISE(ABORT,'invalid_request_category') END;\nEND","table":"requests","type":"trigger"},{"name":"request_category_shape_insert","sql":"CREATE TRIGGER request_category_shape_insert BEFORE INSERT ON request_categories\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' BEGIN\n SELECT CASE WHEN NEW.parent_id IS NOT NULL AND NOT EXISTS(\n  SELECT 1 FROM request_categories parent WHERE parent.id=NEW.parent_id AND parent.board_id=NEW.board_id\n   AND parent.parent_id IS NULL AND parent.merged_into_category_id IS NULL\n ) THEN RAISE(ABORT,'invalid_category_parent') END;\n SELECT CASE WHEN NEW.parent_id IS NOT NULL AND EXISTS(SELECT 1 FROM request_categories child WHERE child.parent_id=NEW.id)\n  THEN RAISE(ABORT,'category_depth_exceeded') END;\n SELECT CASE WHEN NEW.merged_into_category_id IS NOT NULL AND NOT EXISTS(\n  SELECT 1 FROM request_categories target WHERE target.id=NEW.merged_into_category_id AND target.board_id=NEW.board_id\n   AND target.archived_at IS NULL AND target.merged_into_category_id IS NULL\n ) THEN RAISE(ABORT,'invalid_category_merge') END;\nEND","table":"request_categories","type":"trigger"},{"name":"request_category_shape_update","sql":"CREATE TRIGGER request_category_shape_update BEFORE UPDATE ON request_categories\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' BEGIN\n SELECT CASE WHEN NEW.parent_id IS NOT NULL AND NOT EXISTS(\n  SELECT 1 FROM request_categories parent WHERE parent.id=NEW.parent_id AND parent.board_id=NEW.board_id\n   AND parent.parent_id IS NULL AND parent.merged_into_category_id IS NULL\n ) THEN RAISE(ABORT,'invalid_category_parent') END;\n SELECT CASE WHEN NEW.parent_id IS NOT NULL AND EXISTS(SELECT 1 FROM request_categories child WHERE child.parent_id=NEW.id)\n  THEN RAISE(ABORT,'category_depth_exceeded') END;\n SELECT CASE WHEN NEW.merged_into_category_id IS NOT NULL AND NOT EXISTS(\n  SELECT 1 FROM request_categories target WHERE target.id=NEW.merged_into_category_id AND target.board_id=NEW.board_id\n   AND target.archived_at IS NULL AND target.merged_into_category_id IS NULL\n ) THEN RAISE(ABORT,'invalid_category_merge') END;\nEND","table":"request_categories","type":"trigger"},{"name":"request_comment_edits_comment_state_idx","sql":"CREATE INDEX request_comment_edits_comment_state_idx\n  ON request_comment_edits(comment_id, moderation_state, created_at DESC)","table":"request_comment_edits","type":"index"},{"name":"request_comment_origin","sql":"CREATE TRIGGER request_comment_origin AFTER INSERT ON request_comments WHEN NEW.origin_request_id IS NULL\nBEGIN UPDATE request_comments SET origin_request_id=NEW.request_id WHERE id=NEW.id; END","table":"request_comments","type":"trigger"},{"name":"request_content_submissions_request_state_idx","sql":"CREATE INDEX request_content_submissions_request_state_idx\n  ON request_content_submissions(request_id, moderation_state, created_at DESC)","table":"request_content_submissions","type":"index"},{"name":"request_merges_active_source_idx","sql":"CREATE UNIQUE INDEX request_merges_active_source_idx ON request_merges(source_request_id) WHERE unmerged_at IS NULL","table":"request_merges","type":"index"},{"name":"request_merges_target_active_idx","sql":"CREATE INDEX request_merges_target_active_idx ON request_merges(target_request_id, unmerged_at)","table":"request_merges","type":"index"},{"name":"request_moderation_appeals_request_state_idx","sql":"CREATE INDEX request_moderation_appeals_request_state_idx ON request_moderation_appeals(request_id, state, created_at DESC)","table":"request_moderation_appeals","type":"index"},{"name":"request_moderation_events_request_idx","sql":"CREATE INDEX request_moderation_events_request_idx ON request_moderation_events(request_id, created_at DESC)","table":"request_moderation_events","type":"index"},{"name":"request_notes_request_idx","sql":"CREATE INDEX request_notes_request_idx ON request_notes(request_id, created_at DESC)","table":"request_notes","type":"index"},{"name":"request_status_action","sql":"CREATE UNIQUE INDEX request_status_action ON request_status_updates(request_id,action_key)","table":"request_status_updates","type":"index"},{"name":"request_status_mapping_insert","sql":"CREATE TRIGGER request_status_mapping_insert AFTER INSERT ON roadmap_request_mappings\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.approved_at IS NOT NULL AND NEW.withdrawn_at IS NULL BEGIN\n UPDATE requests SET latest_status_source='roadmap',mapped_status_changed_at=NEW.approved_at WHERE id=NEW.request_id;\nEND","table":"roadmap_request_mappings","type":"trigger"},{"name":"request_status_mapping_update","sql":"CREATE TRIGGER request_status_mapping_update AFTER UPDATE OF approved_at,withdrawn_at ON roadmap_request_mappings\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.approved_at IS NOT NULL AND NEW.withdrawn_at IS NULL AND (NEW.approved_at IS NOT OLD.approved_at OR OLD.withdrawn_at IS NOT NULL) BEGIN\n UPDATE requests SET latest_status_source='roadmap',mapped_status_changed_at=NEW.approved_at WHERE id=NEW.request_id;\nEND","table":"roadmap_request_mappings","type":"trigger"},{"name":"request_status_roadmap_approval","sql":"CREATE TRIGGER request_status_roadmap_approval AFTER UPDATE OF approved_at,withdrawn_at ON roadmap_publications\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.approved_at IS NOT NULL AND NEW.withdrawn_at IS NULL AND (NEW.approved_at IS NOT OLD.approved_at OR OLD.withdrawn_at IS NOT NULL) BEGIN\n UPDATE requests SET latest_status_source='roadmap',mapped_status_changed_at=NEW.approved_at WHERE id IN\n (SELECT request_id FROM roadmap_request_mappings WHERE roadmap_item_id=NEW.roadmap_item_id AND approved_at IS NOT NULL AND withdrawn_at IS NULL);\nEND","table":"roadmap_publications","type":"trigger"},{"name":"request_status_roadmap_transition","sql":"CREATE TRIGGER request_status_roadmap_transition AFTER UPDATE OF status ON roadmap_items WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.status IS NOT OLD.status BEGIN\n UPDATE requests SET latest_status_source='roadmap',mapped_status_changed_at=NEW.updated_at WHERE id IN\n (SELECT m.request_id FROM roadmap_request_mappings m JOIN roadmap_publications p ON p.roadmap_item_id=m.roadmap_item_id\n WHERE m.roadmap_item_id=NEW.id AND m.approved_at IS NOT NULL AND m.withdrawn_at IS NULL AND p.approved_at IS NOT NULL AND p.withdrawn_at IS NULL);\nEND","table":"roadmap_items","type":"trigger"},{"name":"request_status_updates_request_published_idx","sql":"CREATE INDEX request_status_updates_request_published_idx ON request_status_updates(request_id, published_at DESC)","table":"request_status_updates","type":"index"},{"name":"request_status_version","sql":"CREATE UNIQUE INDEX request_status_version ON request_status_updates(request_id,publication_version)","table":"request_status_updates","type":"index"},{"name":"request_unmerge_once","sql":"CREATE TRIGGER request_unmerge_once BEFORE UPDATE OF unmerged_at ON request_merges\nWHEN OLD.unmerged_at IS NOT NULL\nBEGIN SELECT RAISE(ABORT,'request_unmerge_conflict'); END","table":"request_merges","type":"trigger"},{"name":"request_votes_trending_idx","sql":"CREATE INDEX request_votes_trending_idx ON request_votes(request_id,created_at)","table":"request_votes","type":"index"},{"name":"requester_addresses_requester_id_idx","sql":"CREATE INDEX requester_addresses_requester_id_idx ON requester_addresses(requester_id)","table":"requester_addresses","type":"index"},{"name":"requester_identity_merges_source_idx","sql":"CREATE UNIQUE INDEX requester_identity_merges_source_idx ON requester_identity_merges(source_requester_id)","table":"requester_identity_merges","type":"index"},{"name":"requester_pending_action_bindings_expires_idx","sql":"CREATE INDEX requester_pending_action_bindings_expires_idx\n  ON requester_pending_action_bindings(expires_at)","table":"requester_pending_action_bindings","type":"index"},{"name":"requester_pending_actions_expiry_idx","sql":"CREATE INDEX requester_pending_actions_expiry_idx ON requester_pending_actions(expires_at, claimed_at)","table":"requester_pending_actions","type":"index"},{"name":"requester_update_permissions_requester_idx","sql":"CREATE INDEX requester_update_permissions_requester_idx ON requester_update_permissions(requester_id, requester_address_id, revoked_at, granted_at DESC)","table":"requester_update_permissions","type":"index"},{"name":"requests_board_public_state_idx","sql":"CREATE INDEX requests_board_public_state_idx ON requests(board_id, public_state)","table":"requests","type":"index"},{"name":"requests_category_public_idx","sql":"CREATE INDEX requests_category_public_idx ON requests(category_id,moderation_state,published_at)","table":"requests","type":"index"},{"name":"requests_merged_into_idx","sql":"CREATE INDEX requests_merged_into_idx ON requests(merged_into_request_id)","table":"requests","type":"index"},{"name":"roadmap_approve_validate_insert","sql":"CREATE TRIGGER roadmap_approve_validate_insert BEFORE INSERT ON roadmap_publications\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.board_id IS NOT NULL\nBEGIN\n SELECT RAISE(ABORT,'public board required') WHERE NOT EXISTS(SELECT 1 FROM boards WHERE id=NEW.board_id AND visibility='public' AND archived_at IS NULL);\n SELECT RAISE(ABORT,'Dropped item cannot be approved') WHERE (SELECT status FROM roadmap_items WHERE id=NEW.roadmap_item_id)='dropped';\nEND","table":"roadmap_publications","type":"trigger"},{"name":"roadmap_approve_validate_update","sql":"CREATE TRIGGER roadmap_approve_validate_update BEFORE UPDATE OF approved_at,board_id ON roadmap_publications\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.board_id IS NOT NULL AND NEW.withdrawn_at IS NULL\nBEGIN\n SELECT RAISE(ABORT,'public board required') WHERE NOT EXISTS(SELECT 1 FROM boards WHERE id=NEW.board_id AND visibility='public' AND archived_at IS NULL);\n SELECT RAISE(ABORT,'Dropped item cannot be approved') WHERE (SELECT status FROM roadmap_items WHERE id=NEW.roadmap_item_id)='dropped';\nEND","table":"roadmap_publications","type":"trigger"},{"name":"roadmap_item_bet_unique_insert","sql":"CREATE TRIGGER roadmap_item_bet_unique_insert BEFORE INSERT ON roadmap_items\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.candidate_bet_id IS NOT NULL\n AND EXISTS(SELECT 1 FROM roadmap_items WHERE candidate_bet_id=NEW.candidate_bet_id)\n AND NOT EXISTS(SELECT 1 FROM roadmap_items WHERE id=NEW.id AND candidate_bet_id=NEW.candidate_bet_id)\nBEGIN SELECT RAISE(ABORT,'Bet already has a roadmap item'); END","table":"roadmap_items","type":"trigger"},{"name":"roadmap_item_bet_unique_update","sql":"CREATE TRIGGER roadmap_item_bet_unique_update BEFORE UPDATE OF candidate_bet_id ON roadmap_items\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.candidate_bet_id IS NOT OLD.candidate_bet_id\n AND NEW.candidate_bet_id IS NOT NULL AND EXISTS(SELECT 1 FROM roadmap_items WHERE candidate_bet_id=NEW.candidate_bet_id AND id!=NEW.id)\nBEGIN SELECT RAISE(ABORT,'Bet already has a roadmap item'); END","table":"roadmap_items","type":"trigger"},{"name":"roadmap_item_candidate_bet","sql":"CREATE INDEX roadmap_item_candidate_bet ON roadmap_items(candidate_bet_id)","table":"roadmap_items","type":"index"},{"name":"roadmap_items_status_idx","sql":"CREATE INDEX roadmap_items_status_idx ON roadmap_items(status)","table":"roadmap_items","type":"index"},{"name":"roadmap_mapping_validate","sql":"CREATE TRIGGER roadmap_mapping_validate BEFORE INSERT ON roadmap_request_mappings\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.approved_at IS NOT NULL AND NEW.withdrawn_at IS NULL\nBEGIN\n SELECT RAISE(ABORT,'published request required') WHERE NOT EXISTS(SELECT 1 FROM requests r JOIN boards b ON b.id=r.board_id LEFT JOIN requesters a ON a.id=r.author_requester_id WHERE r.id=NEW.request_id AND r.moderation_state='approved' AND r.published_at IS NOT NULL AND r.withdrawn_at IS NULL AND r.merged_into_request_id IS NULL AND b.visibility='public' AND (a.id IS NULL OR a.blocked_at IS NULL));\nEND","table":"roadmap_request_mappings","type":"trigger"},{"name":"roadmap_move_changed","sql":"CREATE TRIGGER roadmap_move_changed BEFORE INSERT ON roadmap_transitions\nWHEN NEW.action_key IS NOT NULL AND NEW.from_status=NEW.to_status\nBEGIN SELECT RAISE(ABORT,'Choose a different status'); END","table":"roadmap_transitions","type":"trigger"},{"name":"roadmap_publication_identity","sql":"CREATE TRIGGER roadmap_publication_identity AFTER INSERT ON roadmap_publications WHEN NEW.public_slug IS NULL\nBEGIN UPDATE roadmap_publications SET public_slug='roadmap-'||lower(hex(randomblob(16))) WHERE id=NEW.id; END","table":"roadmap_publications","type":"trigger"},{"name":"roadmap_publication_public_slug","sql":"CREATE UNIQUE INDEX roadmap_publication_public_slug ON roadmap_publications(public_slug)","table":"roadmap_publications","type":"index"},{"name":"roadmap_transition_action_key","sql":"CREATE UNIQUE INDEX roadmap_transition_action_key ON roadmap_transitions(action_key) WHERE action_key IS NOT NULL","table":"roadmap_transitions","type":"index"},{"name":"roadmap_update_contexts_immutable_delete","sql":"CREATE TRIGGER roadmap_update_contexts_immutable_delete BEFORE DELETE ON roadmap_update_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_contexts","type":"trigger"},{"name":"roadmap_update_contexts_immutable_insert","sql":"CREATE TRIGGER roadmap_update_contexts_immutable_insert BEFORE INSERT ON roadmap_update_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_contexts","type":"trigger"},{"name":"roadmap_update_contexts_immutable_update","sql":"CREATE TRIGGER roadmap_update_contexts_immutable_update BEFORE UPDATE ON roadmap_update_contexts\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_contexts","type":"trigger"},{"name":"roadmap_update_histories_immutable_delete","sql":"CREATE TRIGGER roadmap_update_histories_immutable_delete BEFORE DELETE ON roadmap_update_histories\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_histories","type":"trigger"},{"name":"roadmap_update_histories_immutable_insert","sql":"CREATE TRIGGER roadmap_update_histories_immutable_insert BEFORE INSERT ON roadmap_update_histories\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_histories","type":"trigger"},{"name":"roadmap_update_histories_immutable_update","sql":"CREATE TRIGGER roadmap_update_histories_immutable_update BEFORE UPDATE ON roadmap_update_histories\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_histories","type":"trigger"},{"name":"roadmap_update_targets_immutable_delete","sql":"CREATE TRIGGER roadmap_update_targets_immutable_delete BEFORE DELETE ON roadmap_update_targets\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_targets","type":"trigger"},{"name":"roadmap_update_targets_immutable_insert","sql":"CREATE TRIGGER roadmap_update_targets_immutable_insert BEFORE INSERT ON roadmap_update_targets\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_targets","type":"trigger"},{"name":"roadmap_update_targets_immutable_update","sql":"CREATE TRIGGER roadmap_update_targets_immutable_update BEFORE UPDATE ON roadmap_update_targets\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND (EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=OLD.version_id AND v.snapshot_sealed_at IS NOT NULL) OR EXISTS(SELECT 1 FROM roadmap_update_versions v WHERE v.id=NEW.version_id AND v.snapshot_sealed_at IS NOT NULL))\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_targets","type":"trigger"},{"name":"roadmap_update_versions_seal_immutable","sql":"CREATE TRIGGER roadmap_update_versions_seal_immutable BEFORE UPDATE OF snapshot_sealed_at,publication_claim ON roadmap_update_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.snapshot_sealed_at IS NOT NULL\n AND (NEW.snapshot_sealed_at IS NOT OLD.snapshot_sealed_at OR NEW.publication_claim IS NOT OLD.publication_claim)\nBEGIN SELECT RAISE(ABORT,'published snapshot is immutable'); END","table":"roadmap_update_versions","type":"trigger"},{"name":"roadmap_wording_immutable","sql":"CREATE TRIGGER roadmap_wording_immutable BEFORE UPDATE OF public_status,title,problem,body,public_slug,approval_id,approval_at,approval_updated_at,discarded_at ON roadmap_update_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND OLD.snapshot_sealed_at IS NOT NULL\nBEGIN SELECT RAISE(ABORT,'published wording is immutable'); END","table":"roadmap_update_versions","type":"trigger"}],"sourceIdentity":"6cf421b1-d598-49e0-8dd9-3a0b386be9eb","tables":[{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"slug","notnull":1,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"internal_owner_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"revenue_cents","notnull":0,"pk":0,"type":"INTEGER"},{"name":"renewal_date","notnull":0,"pk":0,"type":"TEXT"},{"name":"health","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["operators"],"name":"accounts","rowidAlias":null,"sql":"CREATE TABLE accounts (\n  id TEXT PRIMARY KEY NOT NULL,\n  slug TEXT NOT NULL UNIQUE,\n  name TEXT NOT NULL,\n  internal_owner_id TEXT REFERENCES operators(id),\n  revenue_cents INTEGER,\n  renewal_date TEXT,\n  health TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"request_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"evidence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"storage_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"original_filename","notnull":1,"pk":0,"type":"TEXT"},{"name":"content_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"byte_size","notnull":1,"pk":0,"type":"INTEGER"},{"name":"public_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"rejection_reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"origin_request_id","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["evidence_items","requests"],"name":"attachments","rowidAlias":null,"sql":"CREATE TABLE attachments (\n  id TEXT PRIMARY KEY NOT NULL,\n  request_id TEXT REFERENCES requests(id),\n  evidence_id TEXT REFERENCES evidence_items(id),\n  storage_key TEXT NOT NULL UNIQUE,\n  original_filename TEXT NOT NULL,\n  content_type TEXT NOT NULL,\n  byte_size INTEGER NOT NULL,\n  public_state TEXT NOT NULL CHECK (public_state IN ('operator_only', 'published', 'rejected')),\n  rejection_reason TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, origin_request_id TEXT,\n  CHECK ((request_id IS NOT NULL AND evidence_id IS NULL) OR (request_id IS NULL AND evidence_id IS NOT NULL))\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"actor_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"action","notnull":1,"pk":0,"type":"TEXT"},{"name":"entity_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"entity_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"occurred_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"details_json","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":[],"name":"audit_entries","rowidAlias":null,"sql":"CREATE TABLE audit_entries (\n  id TEXT PRIMARY KEY NOT NULL,\n  actor_type TEXT NOT NULL CHECK (actor_type IN ('operator', 'system')),\n  actor_id TEXT,\n  action TEXT NOT NULL,\n  entity_type TEXT NOT NULL,\n  entity_id TEXT,\n  occurred_at TEXT NOT NULL,\n  details_json TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"slug","notnull":1,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"visibility","notnull":1,"pk":0,"type":"TEXT"},{"name":"position","notnull":1,"pk":0,"type":"INTEGER"},{"name":"archived_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"category_mode","notnull":1,"pk":0,"type":"TEXT"},{"name":"posting_policy","notnull":1,"pk":0,"type":"TEXT"},{"name":"comments_allowed","notnull":1,"pk":0,"type":"INTEGER"},{"name":"show_vote_counts","notnull":1,"pk":0,"type":"INTEGER"},{"name":"show_voters","notnull":1,"pk":0,"type":"INTEGER"},{"name":"anonymous_requesters","notnull":1,"pk":0,"type":"INTEGER"},{"name":"vote_subscriptions","notnull":1,"pk":0,"type":"INTEGER"},{"name":"vote_subscription_version","notnull":1,"pk":0,"type":"INTEGER"}],"count":1,"dependencies":[],"name":"boards","rowidAlias":null,"sql":"CREATE TABLE boards (\n  id TEXT PRIMARY KEY NOT NULL,\n  slug TEXT NOT NULL UNIQUE,\n  name TEXT NOT NULL,\n  visibility TEXT NOT NULL CHECK (visibility IN ('public', 'internal')),\n  position INTEGER NOT NULL,\n  archived_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n, category_mode TEXT NOT NULL DEFAULT 'off' CHECK(category_mode IN ('off','optional','required')), posting_policy TEXT NOT NULL DEFAULT 'requesters' CHECK(posting_policy IN ('requesters','operators')), comments_allowed INTEGER NOT NULL DEFAULT 1 CHECK(comments_allowed IN (0,1)), show_vote_counts INTEGER NOT NULL DEFAULT 1 CHECK(show_vote_counts IN (0,1)), show_voters INTEGER NOT NULL DEFAULT 0 CHECK(show_voters IN (0,1)), anonymous_requesters INTEGER NOT NULL DEFAULT 0 CHECK(anonymous_requesters IN (0,1)), vote_subscriptions INTEGER NOT NULL DEFAULT 0 CHECK(vote_subscriptions IN(0,1)), vote_subscription_version INTEGER NOT NULL DEFAULT 1)"},{"columns":[{"name":"candidate_bet_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"account_id","notnull":1,"pk":2,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["accounts","candidate_bets"],"name":"candidate_bet_account_links","rowidAlias":null,"sql":"CREATE TABLE candidate_bet_account_links (\n  candidate_bet_id TEXT NOT NULL REFERENCES candidate_bets(id),\n  account_id TEXT NOT NULL REFERENCES accounts(id),\n  created_at TEXT NOT NULL,\n  PRIMARY KEY (candidate_bet_id, account_id)\n)"},{"columns":[{"name":"candidate_bet_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"evidence_id","notnull":1,"pk":2,"type":"TEXT"},{"name":"stance","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["candidate_bets","evidence_items"],"name":"candidate_bet_evidence_links","rowidAlias":null,"sql":"CREATE TABLE candidate_bet_evidence_links (\n  candidate_bet_id TEXT NOT NULL REFERENCES candidate_bets(id),\n  evidence_id TEXT NOT NULL REFERENCES evidence_items(id),\n  stance TEXT NOT NULL CHECK (stance IN ('supporting', 'contradicting')),\n  created_at TEXT NOT NULL,\n  PRIMARY KEY (candidate_bet_id, evidence_id)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"decision_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"title","notnull":1,"pk":0,"type":"TEXT"},{"name":"summary","notnull":1,"pk":0,"type":"TEXT"},{"name":"urgency","notnull":0,"pk":0,"type":"TEXT"},{"name":"delivery_shape","notnull":0,"pk":0,"type":"TEXT"},{"name":"success_measure","notnull":0,"pk":0,"type":"TEXT"},{"name":"assumptions","notnull":0,"pk":0,"type":"TEXT"},{"name":"counter_evidence","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["decisions"],"name":"candidate_bets","rowidAlias":null,"sql":"CREATE TABLE candidate_bets (\n  id TEXT PRIMARY KEY NOT NULL,\n  decision_id TEXT NOT NULL REFERENCES decisions(id),\n  title TEXT NOT NULL,\n  summary TEXT NOT NULL,\n  urgency TEXT,\n  delivery_shape TEXT,\n  success_measure TEXT,\n  assumptions TEXT,\n  counter_evidence TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"entity_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"field_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":[],"name":"custom_field_definitions","rowidAlias":null,"sql":"CREATE TABLE custom_field_definitions (\n  id TEXT PRIMARY KEY NOT NULL,\n  entity_type TEXT NOT NULL,\n  name TEXT NOT NULL,\n  field_type TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(entity_type, name)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"definition_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"entity_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"value_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["custom_field_definitions"],"name":"custom_field_values","rowidAlias":null,"sql":"CREATE TABLE custom_field_values (\n  id TEXT PRIMARY KEY NOT NULL,\n  definition_id TEXT NOT NULL REFERENCES custom_field_definitions(id),\n  entity_id TEXT NOT NULL,\n  value_json TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(definition_id, entity_id)\n)"},{"columns":[{"name":"singleton","notnull":0,"pk":1,"type":"INTEGER"},{"name":"origin","notnull":1,"pk":0,"type":"TEXT"},{"name":"epoch","notnull":1,"pk":0,"type":"INTEGER"},{"name":"phase","notnull":1,"pk":0,"type":"TEXT"},{"name":"lock_id","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"data_state","rowidAlias":null,"sql":"CREATE TABLE data_state (\n singleton INTEGER PRIMARY KEY CHECK(singleton=1), origin TEXT NOT NULL,\n epoch INTEGER NOT NULL DEFAULT 0, phase TEXT NOT NULL DEFAULT 'idle' CHECK(phase IN ('idle','locked','applying')),\n lock_id TEXT\n)"},{"columns":[{"name":"epoch","notnull":1,"pk":0,"type":"INTEGER"},{"name":"table_name","notnull":1,"pk":1,"type":"TEXT"},{"name":"key_hash","notnull":1,"pk":2,"type":"TEXT"}],"count":0,"dependencies":[],"name":"data_tombstones","rowidAlias":null,"sql":"CREATE TABLE data_tombstones (\n epoch INTEGER NOT NULL, table_name TEXT NOT NULL, key_hash TEXT NOT NULL,\n PRIMARY KEY(table_name,key_hash)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"decision_revision_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"candidate_bet_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"disposition","notnull":1,"pk":0,"type":"TEXT"},{"name":"title","notnull":1,"pk":0,"type":"TEXT"},{"name":"summary","notnull":1,"pk":0,"type":"TEXT"},{"name":"urgency","notnull":0,"pk":0,"type":"TEXT"},{"name":"delivery_shape","notnull":0,"pk":0,"type":"TEXT"},{"name":"success_measure","notnull":0,"pk":0,"type":"TEXT"},{"name":"affected_requester_count","notnull":1,"pk":0,"type":"INTEGER"},{"name":"affected_account_count","notnull":1,"pk":0,"type":"INTEGER"},{"name":"supporting_count","notnull":1,"pk":0,"type":"INTEGER"},{"name":"latest_support_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"contradicting_count","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["candidate_bets","decision_revisions"],"name":"decision_bet_snapshots","rowidAlias":null,"sql":"CREATE TABLE decision_bet_snapshots (\n id TEXT PRIMARY KEY NOT NULL, decision_revision_id TEXT NOT NULL REFERENCES decision_revisions(id),\n candidate_bet_id TEXT NOT NULL REFERENCES candidate_bets(id), disposition TEXT NOT NULL CHECK(disposition IN ('selected','declined')),\n title TEXT NOT NULL, summary TEXT NOT NULL, urgency TEXT, delivery_shape TEXT, success_measure TEXT,\n affected_requester_count INTEGER NOT NULL, affected_account_count INTEGER NOT NULL,\n supporting_count INTEGER NOT NULL, latest_support_at TEXT, contradicting_count INTEGER NOT NULL,\n created_at TEXT NOT NULL, updated_at TEXT NOT NULL,\n UNIQUE(decision_revision_id,candidate_bet_id)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"decision_revision_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"evidence_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"evidence_version_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"candidate_bet_id","notnull":1,