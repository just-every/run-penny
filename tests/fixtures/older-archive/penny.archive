ision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_plan_index_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_plan_index_insert AFTER INSERT ON ik_d1_plan_index BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_plan_index_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_plan_index_update AFTER UPDATE ON ik_d1_plan_index BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_reversal_reports_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_reversal_reports_delete AFTER DELETE ON ik_d1_reversal_reports BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_reversal_reports","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_reversal_reports_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_reversal_reports_insert AFTER INSERT ON ik_d1_reversal_reports BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_reversal_reports","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_reversal_reports_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_reversal_reports_update AFTER UPDATE ON ik_d1_reversal_reports BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_reversal_reports","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_stream_pages_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_stream_pages_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_stream_pages_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_stream_pages_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_stream_pages_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_stream_pages_update AFTER UPDATE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_custody_state_ik_jobs_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_jobs_delete AFTER DELETE ON ik_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_jobs_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_jobs_insert AFTER INSERT ON ik_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_jobs_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_jobs_update AFTER UPDATE ON ik_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.id OR job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_original_sets_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_original_sets_delete AFTER DELETE ON ik_original_sets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_custody_state_ik_original_sets_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_original_sets_insert AFTER INSERT ON ik_original_sets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_custody_state_ik_original_sets_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_original_sets_update AFTER UPDATE ON ik_original_sets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_delete AFTER DELETE ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_insert AFTER INSERT ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_update AFTER UPDATE ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_provenance_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_provenance_delete AFTER DELETE ON ik_provenance BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_custody_state_ik_provenance_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_provenance_insert AFTER INSERT ON ik_provenance BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_custody_state_ik_provenance_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_provenance_update AFTER UPDATE ON ik_provenance BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_custody_state_ik_sources_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_sources_delete AFTER DELETE ON ik_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_sources_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_sources_insert AFTER INSERT ON ik_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_sources_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_sources_update AFTER UPDATE ON ik_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_custody_state_monotonic","sql":"CREATE TRIGGER ik_d1_custody_state_monotonic BEFORE UPDATE ON ik_d1_custody_states WHEN NEW.job_id IS NOT OLD.job_id OR NEW.revision<=OLD.revision BEGIN SELECT RAISE(ABORT,'IMPORT_CUSTODY_STATE_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_publication","sql":"CREATE TRIGGER ik_d1_custody_state_publication BEFORE UPDATE ON ik_d1_custody_states WHEN EXISTS(SELECT 1 FROM ik_d1_publication_fences f JOIN ik_d1_custody_revisions r ON r.job_id=f.job_id WHERE (f.job_id=OLD.job_id OR f.job_id=NEW.job_id) AND r.seal IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_receipt","sql":"CREATE TRIGGER ik_d1_custody_state_receipt AFTER UPDATE ON ik_d1_custody_states BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_stream_delete","sql":"CREATE TRIGGER ik_d1_custody_state_stream_delete BEFORE DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_custody_state_stream_update","sql":"CREATE TRIGGER ik_d1_custody_state_stream_update BEFORE UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_erasure_journal_delete","sql":"CREATE TRIGGER ik_d1_erasure_journal_delete BEFORE DELETE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_insert","sql":"CREATE TRIGGER ik_d1_erasure_journal_insert BEFORE INSERT ON ik_d1_erasure_journal WHEN EXISTS(SELECT 1 FROM ik_d1_erasure_journal WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_time","sql":"CREATE INDEX ik_d1_erasure_journal_time ON ik_d1_erasure_journal(destination, recorded_at)","table":"ik_d1_erasure_journal","type":"index"},{"name":"ik_d1_erasure_journal_update","sql":"CREATE TRIGGER ik_d1_erasure_journal_update BEFORE UPDATE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_progress_binding","sql":"CREATE TRIGGER ik_d1_erasure_progress_binding BEFORE UPDATE ON ik_d1_erasure_progress WHEN NEW.id IS NOT OLD.id OR NEW.destination IS NOT OLD.destination OR NEW.request_hash IS NOT OLD.request_hash OR NEW.created_at IS NOT OLD.created_at OR OLD.phase='complete' BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_OPERATION_CHANGED'); END","table":"ik_d1_erasure_progress","type":"trigger"},{"name":"ik_d1_erasure_progress_delete","sql":"CREATE TRIGGER ik_d1_erasure_progress_delete BEFORE DELETE ON ik_d1_erasure_progress WHEN OLD.phase='complete' BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_OPERATION_CHANGED'); END","table":"ik_d1_erasure_progress","type":"trigger"},{"name":"ik_d1_erasure_progress_insert","sql":"CREATE TRIGGER ik_d1_erasure_progress_insert BEFORE INSERT ON ik_d1_erasure_progress WHEN EXISTS(SELECT 1 FROM ik_d1_erasure_progress WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_OPERATION_CHANGED'); END","table":"ik_d1_erasure_progress","type":"trigger"},{"name":"ik_d1_history_job","sql":"CREATE INDEX ik_d1_history_job ON ik_d1_history(job_id)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_history_source","sql":"CREATE INDEX ik_d1_history_source ON ik_d1_history(source_identity)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_native_staging_binding","sql":"CREATE TRIGGER ik_d1_native_staging_binding BEFORE UPDATE OF id,generation,destination,namespace,mapping_version,principal_id,job_id,fingerprint,job_fence,action,values_count,chunks_count,identities ON ik_d1_native_staging BEGIN SELECT RAISE(ABORT,'IMPORT_NATIVE_STAGE_BINDING_CHANGED'); END","table":"ik_d1_native_staging","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_delete","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_delete AFTER DELETE ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=OLD.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_insert","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_insert AFTER INSERT ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_update","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_update AFTER UPDATE ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_delete","sql":"CREATE TRIGGER ik_d1_native_staging_index_delete AFTER DELETE ON ik_d1_native_staging_index BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_insert","sql":"CREATE TRIGGER ik_d1_native_staging_index_insert AFTER INSERT ON ik_d1_native_staging_index BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_update","sql":"CREATE TRIGGER ik_d1_native_staging_index_update AFTER UPDATE ON ik_d1_native_staging_index BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_source","sql":"CREATE INDEX ik_d1_native_staging_source ON ik_d1_native_staging_index(source_identity,stage_id)","table":"ik_d1_native_staging_index","type":"index"},{"name":"ik_d1_native_staging_target","sql":"CREATE INDEX ik_d1_native_staging_target ON ik_d1_native_staging_index(target_identity,stage_id)","table":"ik_d1_native_staging_index","type":"index"},{"name":"ik_d1_native_staging_values_delete","sql":"CREATE TRIGGER ik_d1_native_staging_values_delete AFTER DELETE ON ik_d1_native_staging_values BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_native_staging_values","type":"trigger"},{"name":"ik_d1_native_staging_values_insert","sql":"CREATE TRIGGER ik_d1_native_staging_values_insert AFTER INSERT ON ik_d1_native_staging_values BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_native_staging_values","type":"trigger"},{"name":"ik_d1_native_staging_values_registered","sql":"CREATE TRIGGER ik_d1_native_staging_values_registered BEFORE INSERT ON ik_d1