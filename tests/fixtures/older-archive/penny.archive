,"type":"trigger"},{"name":"ik_d1_staging_chunks_delete","sql":"CREATE TRIGGER ik_d1_staging_chunks_delete AFTER DELETE ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_insert","sql":"CREATE TRIGGER ik_d1_staging_chunks_insert AFTER INSERT ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_registered","sql":"CREATE TRIGGER ik_d1_staging_chunks_registered BEFORE INSERT ON ik_d1_staging_chunks WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_update","sql":"CREATE TRIGGER ik_d1_staging_chunks_update AFTER UPDATE ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_headers_delete","sql":"CREATE TRIGGER ik_d1_staging_headers_delete AFTER DELETE ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_insert","sql":"CREATE TRIGGER ik_d1_staging_headers_insert AFTER INSERT ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_registered","sql":"CREATE TRIGGER ik_d1_staging_headers_registered BEFORE INSERT ON ik_d1_staging_headers WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_update","sql":"CREATE TRIGGER ik_d1_staging_headers_update AFTER UPDATE ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_index_custody_delete","sql":"CREATE TRIGGER ik_d1_staging_index_custody_delete AFTER DELETE ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_custody_insert","sql":"CREATE TRIGGER ik_d1_staging_index_custody_insert AFTER INSERT ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=NEW.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=NEW.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=NEW.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_custody_update","sql":"CREATE TRIGGER ik_d1_staging_index_custody_update AFTER UPDATE ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_delete","sql":"CREATE TRIGGER ik_d1_staging_index_delete AFTER DELETE ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_insert","sql":"CREATE TRIGGER ik_d1_staging_index_insert AFTER INSERT ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_update","sql":"CREATE TRIGGER ik_d1_staging_index_update AFTER UPDATE ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_originals_delete","sql":"CREATE TRIGGER ik_d1_staging_originals_delete AFTER DELETE ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_insert","sql":"CREATE TRIGGER ik_d1_staging_originals_insert AFTER INSERT ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_registered","sql":"CREATE TRIGGER ik_d1_staging_originals_registered BEFORE INSERT ON ik_d1_staging_originals WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_update","sql":"CREATE TRIGGER ik_d1_staging_originals_update AFTER UPDATE ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_pages_delete","sql":"CREATE TRIGGER ik_d1_staging_pages_delete AFTER DELETE ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_pages_insert","sql":"CREATE TRIGGER ik_d1_staging_pages_insert AFTER INSERT ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_pages_update","sql":"CREATE TRIGGER ik_d1_staging_pages_update AFTER UPDATE ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_source","sql":"CREATE INDEX ik_d1_staging_source ON ik_d1_staging_index(source_identity,stage_id)","table":"ik_d1_staging_index","type":"index"},{"name":"ik_d1_staging_target","sql":"CREATE INDEX ik_d1_staging_target ON ik_d1_staging_index(target_identity,stage_id)","table":"ik_d1_staging_index","type":"index"},{"name":"ik_d1_stream_origin_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_delete BEFORE DELETE ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_insert BEFORE INSERT ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_d1_stream_origins WHERE job_id=NEW.job_id) OR NOT EXISTS(SELECT 1 FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE ((((NEW.job_id IS p.job_id AND NEW.stream_id IS s.id) AND (NEW.ordinal IS p.ordinal AND NEW.page_total IS p.total)) AND ((NEW.job_operation_key IS j.operation_key AND NEW.parent_destination IS s.destination) AND (NEW.parent_namespace IS s.namespace AND (NEW.parent_mapping_version IS s.mapping_version AND NEW.parent_principal_id IS s.principal_id)))) AND (((NEW.parent_fingerprint IS s.fingerprint AND NEW.parent_operation_key IS s.operation_key) AND (NEW.parent_total IS s.total AND (NEW.parent_layout_hash IS s.layout_hash AND p.stream_id IS s.id))) AND ((j.total IS p.total AND j.destination IS s.destination) AND (j.namespace IS s.namespace AND (j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id)))))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_job_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_job_delete AFTER DELETE ON ik_jobs BEGIN DELETE FROM ik_d1_stream_origins WHERE job_id=OLD.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_origin_page_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_page_update","sql":"CREATE TRIGGER ik_d1_stream_origin_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_parent","sql":"CREATE INDEX ik_d1_stream_origin_parent ON ik_d1_stream_origins(stream_id,ordinal)","table":"ik_d1_stream_origins","type":"index"},{"name":"ik_d1_stream_origin_update","sql":"CREATE TRIGGER ik_d1_stream_origin_update BEFORE UPDATE ON ik_d1_stream_origins BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_page_delete","sql":"CREATE TRIGGER ik_d1_stream_page_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_insert","sql":"CREATE TRIGGER ik_d1_stream_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_update","sql":"CREATE TRIGGER ik_d1_stream_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id OR id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_delete BEFORE DELETE ON ik_d1_stream_revisions BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_delete AFTER DELETE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_insert AFTER INSERT ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_update AFTER UPDATE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_insert BEFORE INSERT ON ik_d1_stream_revisions WHEN EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.stream_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_job_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_job_delete AFTER DELETE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_job_insert AFTER INSERT ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_job_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,reversal_policy,reversal_policy_hash ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_update","sql":"CREATE TRIGGER ik_d1_stream_revision_job_update AFTER UPDATE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_page_erasure","sql":"CREATE TRIGGER ik_d1_stream_revision_page_erasure AFTER UPDATE OF erased_records ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_parent_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_delete AFTER DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_insert AFTER INSERT ON ik_d1_streams BEGIN INSERT INTO ik_d1_stream_revisions(stream_id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash) SELECT NEW.id,NEW.destination,NEW.namespace,NEW.mapping_version,NEW.principal_id,NEW.fingerprint,NEW.operation_key,NEW.total,NEW.layout_hash WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.id); UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_update","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_update AFTER UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_update","sql":"CREATE TRIGGER ik_d1_stream_revision_update BEFORE UPDATE ON ik_d1_stream_revisions WHEN NEW.stream_id IS NOT OLD.stream_id OR NEW.destination IS NOT OLD.destination OR NEW.mapping_version IS NOT OLD.mapping_version OR NEW.principal_id IS NOT OLD.principal_id OR NEW.fingerprint IS NOT OLD.fingerprint OR NEW.total IS NOT OLD.total OR NEW.layout_hash IS NOT OLD.layout_hash OR NEW.layout_revision<OLD.layout_revision OR NEW.progress_revision<=OLD.progress_revision OR ((NEW.namespace IS NOT OLD.namespace OR NEW.operation_key IS NOT OLD.operation_key) AND NOT (NEW.namespace='' AND NEW.operation_key='' AND NOT EXISTS(SELECT 1 FROM ik_d1_streams WHERE id=OLD.stream_id) AND EXISTS(SELECT 1 FROM ik_d1_retirements WHERE id=OLD.stream_id AND kind='stream'))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_provenance_job","sql":"CREATE INDEX ik_provenance_job ON ik_provenance(job_id,reversed,ordinal,effect_ordinal)","table":"ik_provenance","type":"index"},{"name":"ik_provenance_source","sql":"CREATE INDEX ik_provenance_source ON ik_provenance(source_identity,reversed)","table":"ik_provenance","type":"index"},{"name":"ik_sources_job","sql":"CREATE INDEX ik_sources_job ON ik_sources(job_id)","table":"ik_sources","type":"index"},{"name":"integration_deliveries_due","sql":"CREATE INDEX integration_deliveries_due ON integration_deliveries(namespace,state,next_at)","table":"integration_deliveries","type":"index"},{"name":"learning_artifact_immutable","sql":"CREATE TRIGGER learning_artifact_immutable BEFORE UPDATE OF body_json,input_hash,investigation_id,version ON learning_artifacts BEGIN SELECT RAISE(ABORT,'learning_artifact_immutable'); END","table":"learning_artifacts","type":"trigger"},{"name":"learning_contested_commitments","sql":"CREATE TRIGGER learning_contested_commitments AFTER UPDATE OF state ON learning_artifacts WHEN NEW.state='contested' BEGIN\n INSERT OR IGNORE INTO learning_invalidations(commitment_id,reason,created_at) SELECT id,'source_or_interpretation_corrected',strftime('%Y-%m-%dT%H:%M:%fZ','now') FROM learning_commitments WHERE artifact_id=NEW.id;\nEND","table":"learning_artifacts","type":"trigger"},{"name":"learning_native_evidence_correction","sql":"CREATE TRIGGER learning_native_evidence_correction AFTER INSERT ON evidence_versions BEGIN\n UPDATE learning_artifacts SET state='contested' WHERE id IN(SELECT c.artifact_id FROM learning_contributions c JOIN learning_observations o ON o.id=c.observation_id WHERE o.evidence_id=NEW.evidence_id);\n UPDATE learning_investigations SET version=version+1,last_reason='native_evidence_corrected' WHERE id IN(SELECT investigation_id FROM learning_observations WHERE evidence_id=NEW.evidence_id);\nEND","table":"evidence_versions","type":"trigger"},{"name":"learning_native_request_correction","sql":"CREATE TRIGGER learning_native_request_correction AFTER UPDATE OF title,description ON requests WHEN NEW.title IS NOT OLD.title OR NEW.description IS NOT OLD.description BEGIN\n UPDATE learning_artifacts SET state='contested' WHERE id IN(SELECT c.artifact_id FROM learning_contributions c JOIN learning_observations o ON o.id=c.observation_id WHERE o.request_id=NEW.id);\n UPDATE learning_investigations SET version=version+1,last_reason='native_request_corrected' WHERE id IN(SELECT investigation_id FROM learning_observations WHERE request_id=NEW.id);\nEND","table":"requests","type":"trigger"},{"name":"learning_one_claim","sql":"CREATE UNIQUE INDEX learning_one_claim ON learning_runs(investigation_id) WHERE state='running'","table":"learning_runs","type":"index"},{"name":"learning_original_immutable","sql":"CREATE TRIGGER learning_original_immutable BEFORE UPDATE ON learning_observations BEGIN SELECT RAISE(ABORT,'learning_original_immutable'); END","table":"learning_observations","type":"trigger"},{"name":"learning_snapshot_immutable","sql":"CREATE TRIGGER learning_snapshot_immutable BEFORE UPDATE ON learning_commitments BEGIN SELECT RAISE(ABORT,'learning_snapshot_immutable'); END","table":"learning_commitments","type":"trigger"},{"name":"notification_author_publication","sql":"CREATE TRIGGER notification_author_publication AFTER UPDATE OF published_at ON requests\nWHEN OLD.published_at IS NULL AND NEW.published_at IS NOT NULL AND NEW.moderation_state='approved'\n AND NEW.author_requester_id IS NOT NULL\n AND EXISTS(SELECT 1 FROM requester_update_permissions p WHERE p.request_id=NEW.id AND p.requester_id=NEW.author_requester_id\n  AND p.source='submission' AND p.revoked_at IS NULL AND p.suppressed_at IS NULL)\n AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT OR IGNORE INTO notification_events(id,request_id,kind,subject_id,body,created_at,updated_at)\n VALUES('publication:'||NEW.id,NEW.id,'status',NEW.id,'Your request is now public.',NEW.published_at,NEW.published_at);\nEND","table":"requests","type":"trigger"},{"name":"notification_batches_due","sql":"CREATE INDEX notification_batches_due ON notification_batches(state,next_attempt_at)","table":"notification_batches","type":"index"},{"name":"notification_comment_approval","sql":"CREATE TRIGGER notification_comment_approval AFTER UPDATE OF moderation_state,published_at ON request_comments\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.moderation_state='approved' AND NEW.published_at IS NOT NULL\n AND (OLD.moderation_state!='approved' OR OLD.published_at IS NULL)\nBEGIN\n INSERT OR IGNORE INTO notification_events(id,request_id,kind,subject_id,body,created_at,updated_at)\n VALUES(NEW.id,NEW.request_id,'comment',NEW.id,NEW.body,NEW.published_at,NEW.published_at);\nEND","table":"request_comments","type":"trigger"},{"name":"notification_comment_insert","sql":"CREATE TRIGGER notification_comment_insert AFTER INSERT ON request_comments\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.moderation_state='approved' AND NEW.published_at IS NOT NULL\nBEGIN\n INSERT OR IGNORE INTO notification_events(id,request_id,kind,subject_id,body,created_at,updated_at)\n VALUES(NEW.id,NEW.request_id,'comment',NEW.id,NEW.body,NEW.published_at,NEW.published_at);\nEND","table":"request_comments","type":"trigger"},{"name":"notification_follow_resume","sql":"CREATE TRIGGER notification_follow_resume AFTER UPDATE OF muted_at ON request_follow_contributions\nWHEN OLD.muted_at IS NOT NULL AND NEW.muted_at IS NULL\n AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO notification_link_epochs(address_id,scope,epoch,created_at,updated_at)\n SELECT address.id,root.origin_id,1,NEW.updated_at,NEW.updated_at\n FROM requester_addresses address CROSS JOIN request_canonical_roots root\n WHERE address.requester_id=NEW.requester_id\n  AND root.canonical_id=(SELECT canonical_id FROM request_canonical_roots WHERE origin_id=NEW.request_id)\n ON CONFLICT(address_id,scope) DO UPDATE SET epoch=epoch+1,updated_at=excluded.updated_at;\nEND","table":"request_follow_contributions","type":"trigger"},{"name":"notification_identity_merge_guard","sql":"CREATE TRIGGER notification_identity_merge_guard BEFORE INSERT ON requester_identity_merges\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\n AND EXISTS(SELECT 1 FROM notification_batches WHERE state='sending'\n  AND requester_id IN(NEW.source_requester_id,NEW.target_requester_id))\nBEGIN SELECT RAISE(ABORT,'identity_merge_notification_active'); END","table":"requester_identity_merges","type":"trigger"},{"name":"notification_intents_unbatched","sql":"CREATE INDEX notification_intents_unbatched ON notification_intents(batch_id,created_at)","table":"notification_intents","type":"index"},{"name":"notification_outbox_delivery_idx","sql":"CREATE INDEX notification_outbox_delivery_idx ON notification_outbox(delivery_state, available_at)","table":"notification_outbox","type":"index"},{"name":"notification_outbox_operator_idx","sql":"CREATE INDEX notification_outbox_operator_idx ON notification_outbox(operator_id, created_at DESC)","table":"notification_outbox","type":"index"},{"name":"notification_outbox_requester_idx","sql":"CREATE INDEX notification_outbox_requester_idx ON notification_outbox(requester_id, created_at DESC)","table":"notification_outbox","type":"index"},{"name":"notification_permission_insert","sql":"CREATE TRIGGER notification_permission_insert AFTER INSERT ON requester_update_permissions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN UPDATE requester_update_permissions SET suppressed_at=(SELECT suppressed_at FROM requester_addresses WHERE id=NEW.requester_address_id) WHERE id=NEW.id; END","table":"requester_update_permissions","type":"trigger"},{"name":"notification_permission_renewal","sql":"CREATE TRIGGER notification_permission_renewal AFTER INSERT ON requester_update_permissions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\n AND EXISTS(SELECT 1 FROM requester_update_permissions previous\n  JOIN request_canonical_roots prior_root ON prior_root.origin_id=previous.request_id\n  WHERE previous.id!=NEW.id AND previous.requester_id=NEW.requester_id\n   AND prior_root.canonical_id=(SELECT canonical_id FROM request_canonical_roots WHERE origin_id=NEW.request_id))\nBEGIN\n INSERT INTO notification_link_epochs(address_id,scope,epoch,created_at,updated_at)\n SELECT address.id,root.origin_id,1,NEW.updated_at,NEW.updated_at\n FROM requester_addresses address CROSS JOIN request_canonical_roots root\n WHERE address.requester_id=NEW.requester_id\n  AND root.canonical_id=(SELECT canonical_id FROM request_canonical_roots WHERE origin_id=NEW.request_id)\n ON CONFLICT(address_id,scope) DO UPDATE SET epoch=epoch+1,updated_at=excluded.updated_at;\nEND","table":"requester_update_permissions","type":"trigger"},{"name":"notification_permission_suppression","sql":"CREATE TRIGGER notification_permission_suppression AFTER UPDATE OF suppressed_at ON requester_addresses\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN UPDATE requester_update_permissions SET suppressed_at=NEW.suppressed_at,updated_at=NEW.updated_at WHERE requester_address_id=NEW.id; END","table":"requester_addresses","type":"trigger"},{"name":"notification_recipient_intent","sql":"CREATE TRIGGER notification_recipient_intent AFTER INSERT ON notification_events\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NEW.roadmap_update_version_id IS NULL\nBEGIN\n INSERT INTO notification_intents(event_id,requester_id,address_id,created_at,updated_at)\n SELECT NEW.id,f.requester_id,a.id,NEW.created_at,NEW.created_at\n FROM request_follows f JOIN requesters person ON person.id=f.requester_id\n JOIN requester_addresses a ON a.requester_id=person.id\n JOIN requests r ON r.id=f.request_id JOIN boards b ON b.id=r.board_id\n LEFT JOIN requesters author ON author.id=r.author_requester_id\n WHERE f.request_id=NEW.request_id AND (NEW.id NOT LIKE 'publication:%' OR person.id=r.author_requester_id) AND f.muted_at IS NULL AND person.blocked_at IS NULL\n AND NOT EXISTS(SELECT 1 FROM requester_identity_merges retired WHERE retired.source_requester_id=person.id)\n AND a.verified_at IS NOT NULL AND a.suppressed_at IS NULL\n AND r.moderation_state='approved' AND r.published_at IS NOT NULL AND r.withdrawn_at IS NULL\n AND r.merged_into_request_id IS NULL AND b.visibility='public' AND (author.id IS NULL OR author.blocked_at IS NULL)\n AND NOT EXISTS(SELECT 1 FROM requester_notification_preferences p WHERE p.requester_id=person.id AND p.muted_at IS NOT NULL)\n AND NOT EXISTS(SELECT 1 FROM request_notification_mutes m JOIN request_canonical_roots root ON root.origin_id=m.request_id WHERE m.requester_id=person.id AND root.canonical_id=r.id)\n AND a.id=(SELECT candidate.id FROM requester_addresses candidate\n   JOIN requester_update_permissions permission ON permission.requester_address_id=candidate.id\n   JOIN request_canonical_roots root ON root.origin_id=permission.request_id\n   WHERE candidate.requester_id=person.id AND candidate.verified_at IS NOT NULL AND candidate.suppressed_at IS NULL\n   AND permission.requester_id=person.id AND permission.revoked_at IS NULL AND permission.suppressed_at IS NULL AND root.canonical_id=r.id\n   ORDER BY permission.granted_at,candidate.id LIMIT 1);\nEND","table":"notification_events","type":"trigger"},{"name":"notification_resume_all_insert","sql":"CREATE TRIGGER notification_resume_all_insert AFTER INSERT ON requester_notification_preferences\nWHEN NEW.muted_at IS NULL AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO notification_link_epochs(address_id,scope,epoch,created_at,updated_at)\n SELECT id,'all',1,NEW.updated_at,NEW.updated_at FROM requester_addresses WHERE requester_id=NEW.requester_id\n ON CONFLICT(address_id,scope) DO UPDATE SET epoch=epoch+1,updated_at=excluded.updated_at;\nEND","table":"requester_notification_preferences","type":"trigger"},{"name":"notification_resume_all_update","sql":"CREATE TRIGGER notification_resume_all_update AFTER UPDATE OF muted_at ON requester_notification_preferences\nWHEN NEW.muted_at IS NULL AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO notification_link_epochs(address_id,scope,epoch,created_at,updated_at)\n SELECT id,'all',1,NEW.updated_at,NEW.updated_at FROM requester_addresses WHERE requester_id=NEW.requester_id\n ON CONFLICT(address_id,scope) DO UPDATE SET epoch=epoch+1,updated_at=excluded.updated_at;\nEND","table":"requester_notification_preferences","type":"trigger"},{"name":"notification_status_intent","sql":"CREATE TRIGGER notification_status_intent AFTER INSERT ON request_status_updates\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN\n INSERT INTO notification_events(id,request_id,kind,subject_id,body,created_at,updated_at)\n SELECT NEW.id,NEW.request_id,'status',NEW.id,NEW.body,NEW.published_at,NEW.published_at;\nEND","table":"request_status_updates","type":"trigger"},{"name":"notification_suppression_reverification","sql":"CREATE TRIGGER notification_suppression_reverification AFTER UPDATE OF suppressed_at ON requester_addresses\nWHEN OLD.suppressed_at IS NOT NULL AND NEW.suppressed_at IS NULL AND (SELECT phase FROM data_state WHERE singleton=1)='idle'\nBEGIN UPDATE requester_addresses SET verification_epoch=verification_epoch+1 WHERE id=NEW.id; END","table":"requester_addresses","type":"trigger"},{"name":"operator_sessions_operator_id_idx","sql":"CREATE INDEX operator_sessions_operator_id_idx ON operator_sessions(operator_id)","table":"operator_sessions","type":"index"},{"name":"penny_event_comment_insert","sql":"CREATE TRIGGER penny_event_comment_insert AFTER INSERT ON request_comments\n WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NOT EXISTS(SELECT 1 FROM penny_effect_suppression) AND NEW.moderation_state='approved' AND NEW.published_at IS NOT NULL AND NEW.historical_private=0\n AND (NEW.requester_id IS NULL OR EXISTS(SELECT 1 FROM requesters WHERE id=NEW.requester_id AND blocked_at IS NULL)) AND EXISTS(SELECT 1 FROM requests r JOIN boards b ON b.id=r.board_id WHERE r.id=NEW.request_id AND b.visibility='public' AND r.moderation_state='approved' AND r.published_at IS NOT NULL AND r.withdrawn_at IS NULL AND r.merged_into_request_id IS NULL AND (r.author_requester_id IS NULL OR EXISTS(SELECT 1 FROM requesters u WHERE u.id=r.author_requester_id AND u.blocked_at IS NULL)))\n BEGIN INSERT OR IGNORE INTO penny_integration_events(id,event,request_id,comment_id,created_at) VALUES('comment:'||NEW.id,'comment.published',NEW.request_id,NEW.id,unixepoch()*1000); END","table":"request_comments","type":"trigger"},{"name":"penny_event_comment_update","sql":"CREATE TRIGGER penny_event_comment_update AFTER UPDATE OF published_at,moderation_state ON request_comments\n WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NOT EXISTS(SELECT 1 FROM penny_effect_suppression) AND NEW.moderation_state='approved' AND NEW.published_at IS NOT NULL AND NEW.historical_private=0\n AND (NEW.requester_id IS NULL OR EXISTS(SELECT 1 FROM requesters WHERE id=NEW.requester_id AND blocked_at IS NULL)) AND EXISTS(SELECT 1 FROM requests r JOIN boards b ON b.id=r.board_id WHERE r.id=NEW.request_id AND b.visibility='public' AND r.moderation_state='approved' AND r.published_at IS NOT NULL AND r.withdrawn_at IS NULL AND r.merged_into_request_id IS NULL AND (r.author_requester_id IS NULL OR EXISTS(SELECT 1 FROM requesters u WHERE u.id=r.author_requester_id AND u.blocked_at IS NULL)))\n BEGIN INSERT OR IGNORE INTO penny_integration_events(id,event,request_id,comment_id,created_at) VALUES('comment:'||NEW.id,'comment.published',NEW.request_id,NEW.id,unixepoch()*1000); END","table":"request_comments","type":"trigger"},{"name":"penny_event_release","sql":"CREATE TRIGGER penny_event_release AFTER UPDATE OF state ON releases\n WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NOT EXISTS(SELECT 1 FROM penny_effect_suppression) AND OLD.state='draft' AND NEW.state='published'\n AND EXISTS(SELECT 1 FROM release_versions WHERE id=NEW.current_version_id AND snapshot_sealed_at IS NOT NULL)\n BEGIN INSERT OR IGNORE INTO penny_integration_events(id,event,release_id,version_id,created_at) VALUES('release:'||NEW.current_version_id,'release.published',NEW.id,NEW.current_version_id,unixepoch()*1000); END","table":"releases","type":"trigger"},{"name":"penny_event_request","sql":"CREATE TRIGGER penny_event_request AFTER UPDATE OF published_at ON requests\n WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NOT EXISTS(SELECT 1 FROM penny_effect_suppression) AND OLD.published_at IS NULL AND NEW.published_at IS NOT NULL AND NEW.moderation_state='approved'\n AND NEW.withdrawn_at IS NULL AND NEW.merged_into_request_id IS NULL AND EXISTS(SELECT 1 FROM boards WHERE id=NEW.board_id AND visibility='public')\n BEGIN INSERT OR IGNORE INTO penny_integration_events(id,event,request_id,created_at) VALUES('request:'||NEW.id,'request.published',NEW.id,unixepoch()*1000); END","table":"requests","type":"trigger"},{"name":"penny_event_status","sql":"CREATE TRIGGER penny_event_status AFTER INSERT ON request_status_updates\n WHEN (SELECT phase FROM data_state WHERE singleton=1)='idle' AND NOT EXISTS(SELECT 1 FROM penny_effect_suppression) AND EXISTS(SELECT 1 FROM requests r JOIN boards b ON b.id=r.board_id WHERE r.id=NEW.request_id AND b.visibility='public' AND r.moderation_state='approved' AND r.published_at IS NOT NULL AND r.withdrawn_at IS NULL AND r.merged_into_request_id IS NULL AND (r.author_requester_id IS NULL OR EXISTS(SELECT 1 FROM requesters u WHERE u.id=r.author_requester_id AND u.blocked_at IS NULL)))\n BEGIN INSERT OR IGNORE INTO penny_integration_events(id,event,request_id,status_id,created_at) VALUES('status:'||NEW.id,'status.published',NEW.request_id,NEW.id,unixepoch()*1000); END","table":"request_status_updates","type":"trigger"},{"name":"penny_event_targets","sql":"CREATE TRIGGER penny_event_targets AFTER INSERT ON penny_integration_events\nWHEN NEW.held=0\nBEGIN\n INSERT INTO penny_integration_targets(id,event_id,destination_id)\n SELECT NEW.id||':'||d.id,NEW.id,d.id FROM penny_integration_destinations d JOIN oa_operators o ON o.id=d.native_operator_id\n WHERE d.kind IN('webhook','slack') AND d.revoked_at IS NULL AND o.status='active' AND o.version=d.operator_version\n AND NEW.event IN(SELECT value FROM json_each(d.events_json));\nEND","table":"penny_integration_events","type":"trigger"},{"name":"penny_feedback_import_bundles_delete","sql":"CREATE TRIGGER penny_feedback_import_bundles_delete BEFORE DELETE ON feedback_import_bundles\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_bundles","type":"trigger"},{"name":"penny_feedback_import_bundles_insert","sql":"CREATE TRIGGER penny_feedback_import_bundles_insert BEFORE INSERT ON feedback_import_bundles\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_bundles","type":"trigger"},{"name":"penny_feedback_import_bundles_update","sql":"CREATE TRIGGER penny_feedback_import_bundles_update BEFORE UPDATE ON feedback_import_bundles\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_bundles","type":"trigger"},{"name":"penny_feedback_import_original_chunks_delete","sql":"CREATE TRIGGER penny_feedback_import_original_chunks_delete BEFORE DELETE ON feedback_import_original_chunks\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"penny_feedback_import_original_chunks_insert","sql":"CREATE TRIGGER penny_feedback_import_original_chunks_insert BEFORE INSERT ON feedback_import_original_chunks\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"penny_feedback_import_original_chunks_update","sql":"CREATE TRIGGER penny_feedback_import_original_chunks_update BEFORE UPDATE ON feedback_import_original_chunks\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_original_chunks","type":"trigger"},{"name":"penny_feedback_import_receipt_notes_delete","sql":"CREATE TRIGGER penny_feedback_import_receipt_notes_delete BEFORE DELETE ON feedback_import_receipt_notes\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"penny_feedback_import_receipt_notes_insert","sql":"CREATE TRIGGER penny_feedback_import_receipt_notes_insert BEFORE INSERT ON feedback_import_receipt_notes\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"penny_feedback_import_receipt_notes_update","sql":"CREATE TRIGGER penny_feedback_import_receipt_notes_update BEFORE UPDATE ON feedback_import_receipt_notes\nWHEN NOT EXISTS(SELECT 1 FROM data_state s WHERE s.singleton=1 AND (s.phase='idle' OR (s.phase='applying' AND EXISTS(SELECT 1 FROM data_apply_claims c WHERE c.operation_id=s.lock_id))))\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_receipt_notes","type":"trigger"},{"name":"penny_feedback_import_records_delete","sql":"CREATE TRIGGER penny_feedback_import_records_delete BEFORE DELETE ON feedback_import_records\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_records","type":"trigger"},{"name":"penny_feedback_import_records_insert","sql":"CREATE TRIGGER penny_feedback_import_records_insert BEFORE INSERT ON feedback_import_records\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_records","type":"trigger"},{"name":"penny_feedback_import_records_update","sql":"CREATE TRIGGER penny_feedback_import_records_update BEFORE UPDATE ON feedback_import_records\nWHEN (SELECT phase FROM data_state WHERE singleton=1)<>'idle' AND NOT EXISTS(SELECT 1 FROM data_apply_claims c JOIN data_state s ON s.lock_id=c.operation_id WHERE s.phase='applying')\nBEGIN SELECT RAISE(ABORT,'data_maintenance'); END","table":"feedback_import_records","type":"trigger"},{"name":"penny_feedback_import_tombstones_delete","sql":"CREATE TRIGGER penny_feedback_import_tombstones_delete B