OT NULL,\n  title TEXT NOT NULL,\n  release_type TEXT NOT NULL CHECK (release_type IN ('new', 'improved', 'fixed')),\n  body TEXT NOT NULL,\n  publication_date TEXT,\n  setup_url TEXT,\n  outcome_prompt TEXT NOT NULL,\n  subject_tags_json TEXT NOT NULL,\n  is_portal_current INTEGER NOT NULL CHECK (is_portal_current IN (0, 1)),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, publication_claim TEXT, author_name TEXT, tag_names_json TEXT, snapshot_sealed_at TEXT, original_publication_version_id TEXT REFERENCES release_versions(id), delivery_requested_at TEXT,\n  UNIQUE(release_id, version_number)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"slug","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"current_version_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"author_operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"published_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["operators"],"name":"releases","rowidAlias":null,"sql":"CREATE TABLE releases (\n  id TEXT PRIMARY KEY NOT NULL,\n  slug TEXT NOT NULL UNIQUE,\n  state TEXT NOT NULL CHECK (state IN ('draft', 'published')),\n  current_version_id TEXT,\n  author_operator_id TEXT NOT NULL REFERENCES operators(id),\n  published_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"request_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"storage_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"original_filename","notnull":1,"pk":0,"type":"TEXT"},{"name":"content_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"byte_size","notnull":1,"pk":0,"type":"INTEGER"},{"name":"sha256","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"writing",