l":"CREATE TRIGGER data_guard_roadmap_update_targets_update BEFORE UPDATE ON roadmap_update_targets\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked' BEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"roadmap_update_targets","type":"trigger"},{"name":"data_guard_roadmap_update_versions_delete","sql":"CREATE TRIGGER data_guard_roadmap_update_versions_delete BEFORE DELETE ON roadmap_update_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked' BEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"roadmap_update_versions","type":"trigger"},{"name":"data_guard_roadmap_update_versions_insert","sql":"CREATE TRIGGER data_guard_roadmap_update_versions_insert BEFORE INSERT ON roadmap_update_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked' BEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"roadmap_update_versions","type":"trigger"},{"name":"data_guard_roadmap_update_versions_update","sql":"CREATE TRIGGER data_guard_roadmap_update_versions_update BEFORE UPDATE ON roadmap_update_versions\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked' BEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"roadmap_update_versions","type":"trigger"},{"name":"data_guard_tags_delete","sql":"CREATE TRIGGER data_guard_tags_delete BEFORE DELETE ON tags\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked'\nBEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"tags","type":"trigger"},{"name":"data_guard_tags_insert","sql":"CREATE TRIGGER data_guard_tags_insert BEFORE INSERT ON tags\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked'\nBEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"tags","type":"trigger"},{"name":"data_guard_tags_update","sql":"CREATE TRIGGER data_guard_tags_update BEFORE UPDATE ON tags\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='locked'\nBEGIN SELECT RAISE(ABORT,'data maintenance in progress'); END","table":"tags","type":"trigger"},{"name":"data_wait_for_attachment_writers","sql":"CREATE TRIGGER data_wait_for_attachment_writers BEFORE UPDATE OF phase ON data_state\nWHEN OLD.phase='idle' AND NEW.phase!='idle' AND EXISTS(SELECT 1 FROM request_attachment_uploads WHERE writing=1)\nBEGIN SELECT RAISE(ABORT,'attachment_writer_active'); END","table":"data_state","type":"trigger"},{"name":"data_wait_for_decision_review_mail","sql":"CREATE TRIGGER data_wait_for_decision_review_mail BEFORE UPDATE OF phase ON data_state\nWHEN NEW.phase='locked' AND OLD.phase='idle' AND EXISTS(SELECT 1 FROM decision_review_notifications WHERE state='sending')\nBEGIN SELECT RAISE(ABORT,'notification_writer_active'); END","table":"data_state","type":"trigger"},{"name":"data_wait_for_evidence_writers","sql":"CREATE TRIGGER data_wait_for_evidence_writers BEFORE UPDATE OF phase ON data_state\nWHEN OLD.phase='idle' AND NEW.phase!='idle' AND EXISTS(SELECT 1 FROM evidence_attachment_uploads WHERE writing=1)\nBEGIN SELECT RAISE(ABORT,'attachment_writer_active'); END","table":"data_state","type":"trigger"},{"name":"data_wait_for_notification_writers","sql":"CREATE TRIGGER data_wait_for_notification_writers BEFORE UPDATE OF phase ON data_state\nWHEN OLD.phase='idle' AND NEW.phase!='idle' AND EXISTS(SELECT 1 FROM notification_batches WHERE state='sending')\nBEGIN SELECT RAISE(ABORT,'notification_writer_active'); END","table":"data_state","type":"trigger"},{"name":"data_wait_for_release_writers","sql":"CREATE TRIGGER data_wait_for_release_writers BEFORE UPDATE OF phase ON data_state\nWHEN OLD.phase='idle' AND NEW.phase!='idle' AND EXISTS(SELECT 1 FROM notification_outbox_attempts WHERE state='sending')\nBEGIN SELECT RAISE(ABORT,'notification_writer_active'); END","table":"data_state","type":"trigger"},{"name":"decision_commit_validate","sql":"CREATE TRIGGER decision_commit_validate BEFORE INSERT ON decision_revisions\nWHEN NEW.revision_number=1 AND (SELECT state FROM decisions WHERE id=NEW.decision_id) IN ('draft','ready')\nBEGIN\n SELECT RAISE(ABORT,'Multiple historical roadmap items require resolution') WHERE (SELECT COUNT(*) FROM roadmap_items WHERE candidate_bet_id=NEW.selected_candidate_bet_id)>1;\n SELECT RAISE(ABORT,'Question required') WHERE trim((SELECT question FROM decisions WHERE id=NEW.decision_id),char(9,10,11,12,13,32,160,5760,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8232,8233,8239,8287,12288,65279))='';\n SELECT RAISE(ABORT,'Owner required') WHERE NEW.owner_operator_id IS NULL;\n SELECT RAISE(ABORT,'Selected bet mismatch') WHERE NOT EXISTS(SELECT 1 FROM candidate_bets WHERE id=NEW.selected_candidate_bet_id AND decision_id=NEW.decision_id);\n SELECT RAISE(ABORT,'Linked evidence required') WHERE NOT EXISTS(SELECT 1 FROM candidate_bets b JOIN candidate_bet_evidence_links l ON l.candidate_bet_id=b.id WHERE b.decision_id=NEW.decision_id);\n SELECT RAISE(ABORT,'No viable alternative reason required') WHERE (SELECT COUNT(*) FROM candidate_bets WHERE decision_id=NEW.decision_id)<2 AND COALESCE(trim(NEW.no_viable_alternative_reason),'')='';\nEND","table":"decision_revisions","type":"trigger"},{"name":"decision_editor_serialized","sql":"CREATE TRIGGER decision_editor_serialized BEFORE INSERT ON audit_entries\nWHEN (SELECT phase FROM data_state WHERE singleton=1)!='applying' AND NEW.entity_type='decision' AND NEW.action IN ('bet.added','bet.edited','decision.edited') AND (SELECT state FROM decisions WHERE id=NEW.entity_id) NOT IN ('draft','ready')\nBEGIN SELECT RAISE(ABORT,'Decision already committed'); END","table":"audit_entries","type":"trigger"},{"name":"decision_review_due","sql":"CREATE INDEX decision_review_due ON decisions(state,review_at)","table":"decisions","type":"index"},{"name":"decision_review_restore_hold","sql":"CREATE TRIGGER decision_review_restore_hold AFTER INSERT ON decision_review_notifications\nWHEN (SELECT phase FROM data_state WHERE singleton=1)='applying' AND NEW.state IN('queued','sending','unknown')\nBEGIN UPDATE decision_review_notifications SET state='held',claim_id=NULL,failure_reason='restored_delivery_review_required' WHERE id=NEW.id; END","table":"decision_review_notifications","type":"trigger"},{"name":"decision_revision_validate","sql":"CREATE TRIGGER decision_revision_validate BEFORE INSERT ON decision_revisions\nWHEN NEW.revision_number>1 AND (SELECT phase FROM data_state WHERE singleton=1)!='applying'\nBEGIN\n SELECT RAISE(ABORT,'decision revision changed') WHERE NEW.revision_number!=(SELECT COALESCE(MAX(revision_number),0)+1 FROM decision_revisions WHERE decision_id=NEW.decision_id);\n SELECT RAISE(ABORT,'decision revision requires commitment') WHERE (SELECT state FROM decisions WHERE id=NEW.decision_id) NOT IN('committed','review_due');\n SELECT RAISE(ABORT,'Selected bet mismatch') WHERE NOT EXISTS(SELECT 1 FROM candidate_bets WHERE id=NEW.selected_candidate_bet_id AND decision_id=NEW.decision_id);\n SELECT RAISE(ABORT,'Owner required') WHERE NEW.owner_operator_id IS NULL;\n SELECT RAISE(ABORT,'Linked evidence required') WHERE NOT EXISTS(SELECT 1 FROM candidate_bets b JOIN candidate_bet_evidence_links l ON l.candidate_bet_id=b.id WHERE b.decision_id=NEW.decision_id);\n SELECT RAISE(ABORT,'No viable alternative reason required') WHERE (SELECT COUNT(*) FROM candidate_bets WHERE decision_id=NEW.decision_id)<2 AND COALESCE(trim(NEW.no_viable_alternative_reason),'')='';\n SELECT RAISE(ABORT,'Multiple historical roadmap items require resolution') WHERE (SELECT COUNT(*) FROM roadmap_items WHERE candidate_bet_id=NEW.selected_candidate_bet_id)>1;\nEND","table":"decision_revisions","type":"trigger"},{"name":"decisions_state_review_at_idx","sql":"CREATE INDEX decisions_state_review_at_idx ON decisions(state, review_at)","table":"decisions","type":"index"},{"name":"evidence_attachment_private_insert","sql":"CREATE TRIGGER evidence_attachment_private_insert BEFORE INSERT ON attachments\nWHEN NEW.evidence_id IS NOT NULL AND NEW.public_state!='operator_only'\nBEGIN SELECT RAISE(ABORT,'evidence_attachment_private'); END","table":"attachments","type":"trigger"},{"name":"evidence_attachment_private_update","sql":"CREATE TRIGGER evidence_attachment_private_update BEFORE UPDATE ON attachments\nWHEN NEW.evidence_id IS NOT NULL AND NEW.public_state!='operator_only'\nBEGIN SELECT RAISE(ABORT,'evidence_attachment_private'); END","table":"attachments","type":"trigger"},{"name":"evidence_items_account_observed_idx","sql":"CREATE INDEX evidence_items_account_observed_idx ON evidence_items(account_id, observed_at DESC)","table":"evidence_items","type":"index"},{"name":"evidence_items_review_state_idx","sql":"CREATE INDEX evidence_items_review_state_idx ON evidence_items(review_state)","table":"evidence_items","type":"index"},{"name":"evidence_release_idx","sql":"CREATE INDEX evidence_release_idx ON evidence_items(release_id)","table":"evidence_items","type":"index"},{"name":"feedback_bundle_immutable","sql":"CREATE TRIGGER feedback_bundle_immutable BEFORE UPDATE ON feedback_import_bundles WHEN OLD.sealed=1 AND (SELECT phase FROM data_state WHERE singleton=1)!='applying' BEGIN SELECT RAISE(ABORT,'feedback_bundle_changed'); END","table":"feedback_import_bundles","type":"trigger"},{"name":"feedback_native_accounts_delete","sql":"CREATE TRIGGER feedback_native_accounts_delete AFTER DELETE ON \"accounts\" BEGIN UPDATE feedback_import_native_revision SET revision=revision+1 WHERE singleton=1; END","table":"accounts","type":"trigger"},{"name":"feedback_native_accounts_insert","sql":"CREATE TRIGGER feedback_native_accounts_insert AFTER INSERT ON \"accounts\" BEGIN UPDATE feedback_import_native_revision SET revision=revision+1 WHERE singleton=1; END","table":"accounts","type":"trigger"},{"name":"feedback_native_accounts_update","sql":"CREATE TRIGGER feedback_native_accounts_update AFTER UPDATE ON \"accounts\" BEGIN UPDATE feedback_import_native_revision SET revision=revision+1 WHERE singleton=1; END","table":"accounts","type"