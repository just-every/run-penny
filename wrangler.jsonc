// Penny's Worker configuration for local development and builds. The deployed
// copy (dist/server/wrangler.json) gets the deployment's own resources; the
// local D1 identifier here is a placeholder deploy-kit refuses.
{
  "name": "feedback-penny",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "feedback-penny-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/core" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "feedback-penny-local-files" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "feedback-penny-local-jobs" }],
    "consumers": [{ "queue": "feedback-penny-local-jobs", "max_batch_size": 1, "max_retries": 3 }]
  },
  "services": [{ "binding": "PENNY_LEARNING_EGRESS", "service": "penny-learning-egress" }],
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["* * * * *"] },
  // Public hosted defaults; explicit local .dev.vars supplies the local mode.
  "vars": { "PENNY_ENVIRONMENT": "production", "WORKSPACE_TIMEZONE": "UTC", "MAIL_PROVIDER": "", "MAIL_FROM": "", "MAIL_RELAY_URL": "" }
}
